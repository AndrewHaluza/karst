{
  "name": "karst",
  "displayName": "Karst",
  "version": "1.0.0",
  "description": "Orchestrate AI-agent ticket workflows across a multi-repo stack.",
  "publisher": "karst",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewHaluza/karst.git"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "tsc -p tsconfig.build.json",
    "copy-assets": "node scripts/copy-assets.mjs",
    "build": "npm run clean && npm run compile && npm run copy-assets",
    "vscode:prepublish": "npm run build",
    "rebuild:better-sqlite3": "node scripts/rebuild-better-sqlite3.mjs auto",
    "rebuild:electron": "node scripts/rebuild-better-sqlite3.mjs electron",
    "rebuild:node": "node scripts/rebuild-better-sqlite3.mjs node",
    "pretest": "npm run rebuild:node",
    "dev:extension": "npm run build && npm run rebuild:electron"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "karst",
          "title": "Karst",
          "icon": "media/karst.svg"
        }
      ]
    },
    "views": {
      "karst": [
        {
          "id": "karst.tickets",
          "name": "Tickets",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "karst.openDashboard",
        "title": "Karst: Open Dashboard"
      },
      {
        "command": "karst.openSession",
        "title": "Karst: Open AI Session",
        "icon": "$(terminal)"
      },
      {
        "command": "karst.openTicketForm",
        "title": "Karst: New Ticket",
        "icon": "$(add)"
      },
      {
        "command": "karst.openOnboarding",
        "title": "Karst: New Ticket (deprecated alias)",
        "icon": "$(add)"
      },
      {
        "command": "karst.editTicket",
        "title": "Karst: Edit Ticket",
        "icon": "$(edit)"
      },
      {
        "command": "karst.createFollowUpTicket",
        "title": "Karst: Create Follow-up Ticket",
        "icon": "$(reply)"
      },
      {
        "command": "karst.spinTicket",
        "title": "Karst: Spin Ticket (scope + start servers)",
        "icon": "$(play)"
      },
      {
        "command": "karst.launchWorktreeExtension",
        "title": "Karst: Launch Worktree Extension (Development)"
      },
      {
        "command": "karst.refresh",
        "title": "Karst: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "karst.showAttention",
        "title": "Karst: Show Tickets Needing You",
        "icon": "$(bell)"
      },
      {
        "command": "karst.openTokenUsage",
        "title": "Karst: Token Usage Stats",
        "icon": "$(graph)"
      },
      {
        "command": "karst.showLogs",
        "title": "Karst: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "karst.search",
        "title": "Karst: Filter Tickets",
        "icon": "$(search)"
      },
      {
        "command": "karst.filterState",
        "title": "Karst: Filter by State",
        "icon": "$(filter)"
      },
      {
        "command": "karst.archiveTicket",
        "title": "Karst: Archive Ticket",
        "icon": "$(archive)"
      },
      {
        "command": "karst.unarchiveTicket",
        "title": "Karst: Unarchive Ticket",
        "icon": "$(history)"
      },
      {
        "command": "karst.deleteTicket",
        "title": "Karst: Delete Ticket",
        "icon": "$(trash)"
      },
      {
        "command": "karst.archiveInactiveWorktrees",
        "title": "Karst: Archive Inactive Worktrees",
        "icon": "$(archive)"
      },
      {
        "command": "karst.openSettings",
        "title": "Karst: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "karst.openManifest",
        "title": "Karst: Open karst.yml",
        "icon": "$(file-code)"
      },
      {
        "command": "karst.openGettingStarted",
        "title": "Karst: Getting Started"
      },
      {
        "command": "karst.recheckDeps",
        "title": "Karst: Re-check Required Tools"
      },
      {
        "command": "karst.reportIssue",
        "title": "Karst: Report Issue"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "karst.launchWorktreeExtension",
          "when": "config.karst.launchWorktreeDev.enabled"
        }
      ]
    },
    "configuration": {
      "title": "Karst",
      "properties": {
        "karst.manifestPath": {
          "type": "string",
          "default": "./.karst/karst.yml",
          "description": "Path to the karst manifest (karst.yml), resolved against the workspace root."
        },
        "karst.approachesDir": {
          "type": "string",
          "default": "./.karst/approaches",
          "description": "Directory where installed approach packages are stored (relative to the workspace root)."
        },
        "karst.agentsDir": {
          "type": "string",
          "default": "./.karst/agents",
          "description": "Directory where karst agent files are stored."
        },
        "karst.launchWorktreeDev.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable 'Karst: Launch Worktree Extension (Development)': build a ticket worktree's karst-extension checkout and open it as the extension development host in a new window. Off by default — it is a developer convenience most projects never need."
        },
        "karst.launchWorktreeDev.ide": {
          "type": "string",
          "enum": [
            "auto",
            "vscode",
            "cursor",
            "antigravity",
            "windsurf"
          ],
          "default": "auto",
          "description": "Which editor opens the development window. 'auto' uses the editor this window runs in; a named IDE is launched through its CLI on PATH. Any other editor can be targeted via karst.launchWorktreeDev.idePath."
        },
        "karst.launchWorktreeDev.idePath": {
          "type": "string",
          "default": "",
          "description": "Exact path to an editor CLI (e.g. /usr/local/bin/code) used to open the development window. When set, it wins over karst.launchWorktreeDev.ide."
        }
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.105.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
