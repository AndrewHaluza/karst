{
  "name": "karst",
  "displayName": "Karst",
  "version": "1.0.0",
  "description": "The deterministic rail for AI-agent tickets: real services, multi-repo state, exit-code verdicts.",
  "icon": "media/karst-icon.png",
  "publisher": "Karst",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewHaluza/karst.git"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "lint:react": "eslint src/ui/settings/app",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "tsc -p tsconfig.build.json",
    "copy-assets": "node scripts/copy-assets.mjs",
    "build": "npm run clean && node scripts/build-extension.mjs --production && npm run copy-assets && node scripts/verify-build.mjs",
    "vscode:prepublish": "npm run build",
    "rebuild:better-sqlite3": "node scripts/rebuild-better-sqlite3.mjs auto",
    "rebuild:electron": "node scripts/rebuild-better-sqlite3.mjs electron",
    "rebuild:node": "node scripts/rebuild-better-sqlite3.mjs node",
    "pretest:unit": "npm run rebuild:node",
    "pretest:integration": "npm run rebuild:node",
    "dev:extension": "npm run build && npm run rebuild:electron",
    "inventory:extension": "node scripts/extension-inventory.mjs",
    "docs:lint": "node scripts/docsKeys.mjs lint",
    "docs:index": "node scripts/docsKeys.mjs index",
    "docs:check": "node scripts/docsKeys.mjs lint && node scripts/docsKeys.mjs index --check",
    "pretest:mutation": "npm run rebuild:node",
    "test:mutation": "stryker run",
    "pretest:coverage": "npm run rebuild:node",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:docker": "docker run --rm --init -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npm run test:visual:ci",
    "test:visual:docker:update": "docker run --rm --init -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.63.0-noble npm run test:visual:ci:update",
    "test:visual:ci": "npm ci && npm run typecheck:visual && playwright test",
    "test:visual:ci:update": "npm ci && playwright test --update-snapshots",
    "install:visual-browsers": "playwright install --with-deps chromium",
    "typecheck:visual": "tsc -p tsconfig.visual.json"
  },
  "contributes": {
    "icons": {
      "karst-mark": {
        "description": "Karst mark",
        "default": {
          "fontPath": "media/karst-icons.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "karst",
          "title": "Karst",
          "icon": "media/karst.svg"
        }
      ]
    },
    "views": {
      "karst": [
        {
          "id": "karst.tickets",
          "name": "Tickets",
          "type": "webview"
        }
      ],
      "scm": [
        {
          "id": "karst.diffs",
          "name": "Karst",
          "contextualTitle": "Karst"
        }
      ]
    },
    "commands": [
      {
        "command": "karst.runDoctor",
        "title": "Karst: Run Doctor"
      },
      {
        "command": "karst.openDashboard",
        "title": "Karst: Open Dashboard"
      },
      {
        "command": "karst.openSession",
        "title": "Karst: Open AI Session",
        "icon": "$(terminal)"
      },
      {
        "command": "karst.openTicketForm",
        "title": "Karst: New Ticket",
        "icon": "$(add)"
      },
      {
        "command": "karst.openOnboarding",
        "title": "Karst: New Ticket (deprecated alias)",
        "icon": "$(add)"
      },
      {
        "command": "karst.editTicket",
        "title": "Karst: Edit Ticket",
        "icon": "$(edit)"
      },
      {
        "command": "karst.createFollowUpTicket",
        "title": "Karst: Create Follow-up Ticket",
        "icon": "$(reply)"
      },
      {
        "command": "karst.spinTicket",
        "title": "Karst: Spin Ticket (scope + start servers)",
        "icon": "$(play)"
      },
      {
        "command": "karst.launchWorktreeExtension",
        "title": "Karst: Launch Worktree Extension (Development)"
      },
      {
        "command": "karst.refresh",
        "title": "Karst: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "karst.showAttention",
        "title": "Karst: Show Tickets Needing You",
        "icon": "$(bell)"
      },
      {
        "command": "karst.openTokenUsage",
        "title": "Karst: Token Usage Stats",
        "icon": "$(graph)"
      },
      {
        "command": "karst.openResources",
        "title": "Karst: Resource Monitor",
        "icon": "$(dashboard)"
      },
      {
        "command": "karst.showLogs",
        "title": "Karst: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "karst.search",
        "title": "Karst: Filter Tickets",
        "icon": "$(search)"
      },
      {
        "command": "karst.filterState",
        "title": "Karst: Filter by State",
        "icon": "$(filter)"
      },
      {
        "command": "karst.archiveTicket",
        "title": "Karst: Archive Ticket",
        "icon": "$(archive)"
      },
      {
        "command": "karst.unarchiveTicket",
        "title": "Karst: Unarchive Ticket",
        "icon": "$(history)"
      },
      {
        "command": "karst.pauseTicket",
        "title": "Karst: Pause Ticket Execution",
        "icon": "$(debug-pause)"
      },
      {
        "command": "karst.unpauseTicket",
        "title": "Karst: Resume Ticket Execution",
        "icon": "$(debug-start)"
      },
      {
        "command": "karst.deleteTicket",
        "title": "Karst: Delete Ticket",
        "icon": "$(trash)"
      },
      {
        "command": "karst.archiveInactiveWorktrees",
        "title": "Karst: Archive Inactive Worktrees",
        "icon": "$(archive)"
      },
      {
        "command": "karst.openSettings",
        "title": "Karst: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "karst.openManifest",
        "title": "Karst: Open karst.yml",
        "icon": "$(file-code)"
      },
      {
        "command": "karst.openGettingStarted",
        "title": "Karst: Getting Started"
      },
      {
        "command": "karst.setupAgent",
        "title": "Karst: Set Up with Agent"
      },
      {
        "command": "karst.recheckDeps",
        "title": "Karst: Re-check Required Tools"
      },
      {
        "command": "karst.opencode2.login",
        "title": "Karst: Log in to OpenCode v2"
      },
      {
        "command": "karst.reportIssue",
        "title": "Karst: Report Issue"
      },
      {
        "command": "karst.openTicketScmDiff",
        "title": "Karst: Open Changes"
      },
      {
        "command": "karst.scmOpenFile",
        "title": "Karst: Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "karst.scmDiscard",
        "title": "Karst: Discard Changes",
        "icon": "$(discard)"
      },
      {
        "command": "karst.scmUnstage",
        "title": "Karst: Unstage Changes",
        "icon": "$(remove)"
      },
      {
        "command": "karst.selectDiffsTicket",
        "title": "Karst: Select Ticket for Changes",
        "icon": "$(list-selection)"
      },
      {
        "command": "karst.refreshDiffsTree",
        "title": "Karst: Refresh Changes",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "karst.launchWorktreeExtension",
          "when": "config.karst.launchWorktreeDev.enabled"
        },
        {
          "command": "karst.openTicketScmDiff",
          "when": "false"
        },
        {
          "command": "karst.scmOpenFile",
          "when": "false"
        },
        {
          "command": "karst.scmDiscard",
          "when": "false"
        },
        {
          "command": "karst.scmUnstage",
          "when": "false"
        },
        {
          "command": "karst.selectDiffsTicket",
          "when": "false"
        },
        {
          "command": "karst.refreshDiffsTree",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "karst.selectDiffsTicket",
          "when": "view == karst.diffs",
          "group": "navigation@1"
        },
        {
          "command": "karst.refreshDiffsTree",
          "when": "view == karst.diffs",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "karst.scmOpenFile",
          "when": "view == karst.diffs && viewItem =~ /^karst\\.diffFile\\./",
          "group": "inline@1"
        },
        {
          "command": "karst.scmUnstage",
          "when": "view == karst.diffs && viewItem == karst.diffFile.staged",
          "group": "inline@2"
        },
        {
          "command": "karst.scmDiscard",
          "when": "view == karst.diffs && (viewItem == karst.diffFile.unstaged || viewItem == karst.diffFile.untracked)",
          "group": "inline@2"
        },
        {
          "command": "karst.scmOpenFile",
          "when": "view == karst.diffs && viewItem =~ /^karst\\.diffFile\\./",
          "group": "navigation@1"
        },
        {
          "command": "karst.scmUnstage",
          "when": "view == karst.diffs && viewItem == karst.diffFile.staged",
          "group": "navigation@2"
        },
        {
          "command": "karst.scmDiscard",
          "when": "view == karst.diffs && (viewItem == karst.diffFile.unstaged || viewItem == karst.diffFile.untracked)",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Karst",
      "properties": {
        "karst.manifestPath": {
          "type": "string",
          "default": "./.karst/karst.yml",
          "description": "Path to the karst manifest (karst.yml), resolved against the workspace root."
        },
        "karst.approachesDir": {
          "type": "string",
          "default": "./.karst/approaches",
          "description": "Directory where installed approach packages are stored (relative to the workspace root)."
        },
        "karst.agentsDir": {
          "type": "string",
          "default": "./.karst/agents",
          "description": "Directory where karst agent files are stored."
        },
        "karst.sidebar.edge": {
          "type": "string",
          "enum": [
            "auto",
            "left",
            "right",
            "none"
          ],
          "default": "auto",
          "description": "Which edge of the Karst sidebar draws its 1px resize line, so the drag handle stays findable when the theme's sideBar.border is transparent. 'auto' draws it on the edge opposite workbench.sideBar.location (the edge facing the editor); 'left' or 'right' pins it; 'none' hides it."
        },
        "karst.launchWorktreeDev.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable 'Karst: Launch Worktree Extension (Development)': build a ticket worktree's karst-extension checkout and open it as the extension development host in a new window. Off by default — it is a developer convenience most projects never need."
        },
        "karst.launchWorktreeDev.ide": {
          "type": "string",
          "enum": [
            "auto",
            "vscode",
            "cursor",
            "antigravity",
            "windsurf"
          ],
          "default": "auto",
          "description": "Which editor opens the development window. 'auto' uses the editor this window runs in; a named IDE is launched through its CLI on PATH. Any other editor can be targeted via karst.launchWorktreeDev.idePath."
        },
        "karst.launchWorktreeDev.idePath": {
          "type": "string",
          "default": "",
          "description": "Exact path to an editor CLI (e.g. /usr/local/bin/code) used to open the development window. When set, it wins over karst.launchWorktreeDev.ide."
        },
        "karst.opencode2.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the OpenCode v2 launcher (@opencode/cli 2.x). Required for the 'opencode2' agent core: v2 ships a launcher also named 'opencode', so karst never searches PATH for it. Leave empty to keep the core unavailable."
        }
      }
    }
  },
  "keywords": [],
  "author": "Andrii Haluza",
  "license": "BUSL-1.1",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.105.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/vsce": "4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
