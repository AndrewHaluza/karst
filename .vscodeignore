# Source + build config (dist/ is the shipped output)
src/**
tsconfig.json
tsconfig.build.json
vitest.config.ts
vitest.e2e.config.ts
vitest.mutation.config.ts
stryker.config.json

# Tests + coverage
**/*.test.ts
coverage/**

# Dev docs / scratch (not runtime)
docs/**
shared-docs/**
spikes/**
CLAUDE.md
scripts/**

# karst's own working state: ticket worktrees (a full checkout EACH, plus their
# vitest caches), the registry DB, and stage artifacts. Never runtime, and it
# grows with every ticket — this was 12812 of the vsix's 13369 files (494MB
# unpacked), which is what broke `--install-extension`. A .vscodeignore also
# switches vsce OFF .gitignore entirely, so .karst being git-ignored is not
# enough to keep it out of the package.
.karst/**

# Secrets and local env. A .vscodeignore switches vsce OFF .gitignore
# entirely (see the .karst/** note above), so `.env.local` being git-ignored is
# NOT enough to keep it out of the package — it shipped inside the vsix and
# unpacked into the installed extension directory until this line existed.
.env
.env.*

# opencode's own npm install: an entire second dependency tree that the
# extension never loads. It was 3510 of the vsix's 4025 files (51MB of 21.67MB
# packaged) and dominated `vsce package` wall time. Only `.opencode/commands/`
# is tracked; the rest is untracked working state, same as .karst/**.
.opencode/**

# Generated reports: stryker mutation HTML/JSON (`npm run test:mutation`) and
# any coverage output landing here. Git-ignored, and therefore — see above —
# packaged unless named explicitly.
reports/**

# Marketing media: the launch film, the short cut, the README lockup and the
# screenshot gallery. The README references all of them by absolute
# raw.githubusercontent URL (the Marketplace does not resolve relative paths),
# so they are fetched over HTTPS and never read out of the package — shipping
# them only repeats the vsix-bloat problem the .karst/** note above describes.
# Only the two icons package.json actually points at are kept.
media/**
!media/karst-icon.png
!media/karst.svg

# VCS / lockfile
.git/**
.gitignore
package-lock.json

# install-local.sh build cache: per-target stamps and vsix artifacts. A vsix
# must never be shipped inside another vsix (and the stamps are private state).
.karst-cache/**

# Agent/editor tooling (not runtime)
.superpowers/**
.claude/**
.vscode/**

# Vendored webview libs ship as dist/vendor/xterm copies, never as npm packages.
node_modules/@xterm/**

# Keep only the two runtime dependencies (better-sqlite3 + js-yaml). Everything
# else is devDependencies and must not bloat the VSIX. vsce resolves the
# .vscodeignore before packaging, so this glob prunes ~120 dev packages.
node_modules/** !node_modules/better-sqlite3/** !node_modules/js-yaml/**

# Keep: dist/**, node_modules/** (better-sqlite3 loaded at runtime),
#       package.json, README.md, karst.example.yml,
#       karst.uat-review-setup.md (both root assets are copied into dist/,
#       which is what scaffolding reads), media/karst-icon.png, media/karst.svg
