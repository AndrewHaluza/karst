      const rssMax = Math.max(...rss, 1);
      const cpuVals = cpu.filter((v) => v !== null);
      const cpuMax = Math.max(...cpuVals, 1);
      const x = (i) => (history.length === 1 ? PAD : (i / (history.length - 1)) * (W - PAD * 2) + PAD);
      const y = (v, max) => H - PAD - (v / max) * (H - PAD * 2);
