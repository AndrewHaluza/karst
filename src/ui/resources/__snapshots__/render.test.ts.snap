<script nonce="fixture-nonce-000000000000">
  // ── Karst design system runtime (docs/ui/DESIGN-SYSTEM.md §5) ────────────────
var KARST_WATCHDOG_MS = 45000;
var KARST_FLASH_DONE_MS = 2400;
var KARST_TOAST_SUCCESS_MS = 6000;
var KARST_MAX_TOAST_CHARS = 240;

/** requestId -> { el, timer, wasDisabled }. The single source of "what is in flight". */
var karstPending = {};
var karstReqSeq = 0;

function karstRequestId() {
  karstReqSeq = karstReqSeq + 1;
  return 'k' + karstReqSeq + '-' + karstReqSeq.toString(36);
}

/** Untrusted prose (CLI output, model output, git stderr) collapsed to one capped line. */
function karstOneLine(value) {
  var s = String(value === null || value === undefined ? '' : value).replace(/\\s+/g, ' ').trim();
  return s.length > KARST_MAX_TOAST_CHARS ? s.slice(0, KARST_MAX_TOAST_CHARS - 1) + '…' : s;
}

function karstIsPending(el) {
  if (!el) return false;
  for (var id in karstPending) {
    if (Object.prototype.hasOwnProperty.call(karstPending, id) && karstPending[id].el === el) return true;
  }
  return false;
}

/**
 * Enter pending. aria-busy is the accessible signal, \`disabled\` is the
 * re-trigger guard, and the class is what [[designComponents]] hangs the spinner
 * on. The label is deliberately untouched (UI-R18).
 */
function karstBeginPending(el, requestId) {
  var wasDisabled = el ? !!el.disabled : false;
  if (el) {
    el.setAttribute('aria-busy', 'true');
    el.disabled = true;
    if (el.classList) el.classList.add('is-pending');
  }
  karstPending[requestId] = {
    el: el,
    wasDisabled: wasDisabled,
    timer: setTimeout(function () {
      // Unknown, not failed: the host may simply never reply.
      karstSettle(requestId, null);
    }, KARST_WATCHDOG_MS),
  };
}

/**
 * Terminal result for one request. \`ok\` is true (succeeded), false (failed), or
 * null (unknown — the watchdog fired). A control disabled BEFORE the action
 * stays disabled: settling must not turn "unavailable" into "available".
 */
function karstSettle(requestId, ok, message) {
  var entry = karstPending[requestId];
  if (!entry) return;
  delete karstPending[requestId];
  if (entry.timer !== undefined && entry.timer !== null) clearTimeout(entry.timer);

  var el = entry.el;
  if (el) {
    el.removeAttribute('aria-busy');
    el.disabled = entry.wasDisabled;
    if (el.classList) el.classList.remove('is-pending');
    if (ok === true && el.classList) {
      el.classList.add('is-success');
      setTimeout(function () {
        if (el.classList) el.classList.remove('is-success');
      }, KARST_FLASH_DONE_MS);
    }
  }

  if (ok === false) {
    karstToast('error', karstOneLine(message) || 'That action failed.');
  } else if (ok === null) {
    karstToast('warning', karstOneLine(message) || 'Still running — the result is unknown.');
  } else if (message) {
    karstToast('success', karstOneLine(message));
  }
}

/**
 * Bind a control to an async action. \`send\` receives the requestId and is
 * responsible for posting it to the host; the host replies once with
 * { type: 'action-result', requestId, ok, message } and the webview's message
 * handler calls karstSettle.
 */
function karstAction(el, send, opts) {
  if (!el) return;
  var options = opts || {};
  el.addEventListener('click', function (ev) {
    if (karstIsPending(el)) {
      // Dropped, not queued (UI-R12).
      if (ev && ev.preventDefault) ev.preventDefault();
      return;
    }
    if (el.disabled) return;
    var requestId = karstRequestId();
    karstBeginPending(el, requestId);
    try {
      send(requestId, ev);
    } catch (err) {
      karstSettle(requestId, false, err && err.message ? err.message : String(err));
    }
    if (options.settle === 'immediate') karstSettle(requestId, true);
  });
}

/** The one polite live region per webview (UI-R27). Created on first use. */
function karstToastRoot() {
  var root = document.getElementById('k-toast-root');
  if (root) return root;
  root = document.createElement('div');
  root.setAttribute('id', 'k-toast-root');
  root.setAttribute('class', 'k-toast-root');
  root.setAttribute('role', 'status');
  root.setAttribute('aria-live', 'polite');
  document.body.appendChild(root);
  return root;
}

/**
 * Surface a terminal outcome. Success and warning self-dismiss; an ERROR never
 * does — a failure the user has not read yet is not a failure that has been
 * reported.
 */
function karstToast(kind, message) {
  var text = karstOneLine(message);
  if (!text) return null;
  var root = karstToastRoot();
  var node = document.createElement('div');
  node.classList.add('k-toast');
  node.classList.add('k-toast--' + kind);
  node.textContent = text;
  root.appendChild(node);
  if (kind !== 'error') {
    setTimeout(function () {
      try { root.removeChild(node); } catch (e) { /* already detached */ }
    }, KARST_TOAST_SUCCESS_MS);
  }
  return node;
}
// ── Karst Tabler icon runtime (docs/ui/ICONS.md §3) ──────────────────────────
var KARST_TABLER_ICONS = {"archive":"<path d=\\"M3 6a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2\\"/><path d=\\"M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-10\\"/><path d=\\"M10 12l4 0\\"/>","check":"<path d=\\"M5 12l5 5l10 -10\\"/>","chevron-down":"<path d=\\"M6 9l6 6l6 -6\\"/>","chevron-right":"<path d=\\"M9 6l6 6l-6 6\\"/>","circle-check":"<path d=\\"M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\\"/><path d=\\"M9 12l2 2l4 -4\\"/>","circle-x":"<path d=\\"M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\\"/><path d=\\"M10 10l4 4m0 -4l-4 4\\"/>","copy":"<path d=\\"M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666\\"/><path d=\\"M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1\\"/>","corner-down-right":"<path d=\\"M6 6v6a3 3 0 0 0 3 3h10l-4 -4m0 8l4 -4\\"/>","dots":"<path d=\\"M5 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\\"/><path d=\\"M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\\"/><path d=\\"M19 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\\"/>","external-link":"<path d=\\"M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6\\"/><path d=\\"M11 13l9 -9\\"/><path d=\\"M15 4h5v5\\"/>","file-text":"<path d=\\"M14 3v4a1 1 0 0 0 1 1h4\\"/><path d=\\"M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2\\"/><path d=\\"M9 9l1 0\\"/><path d=\\"M9 13l6 0\\"/><path d=\\"M9 17l6 0\\"/>","folder":"<path d=\\"M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2\\"/>","git-compare":"<path d=\\"M4 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M16 18a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M11 6h5a2 2 0 0 1 2 2v8\\"/><path d=\\"M14 9l-3 -3l3 -3\\"/><path d=\\"M13 18h-5a2 2 0 0 1 -2 -2v-8\\"/><path d=\\"M10 15l3 3l-3 3\\"/>","history":"<path d=\\"M12 8l0 4l2 2\\"/><path d=\\"M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5\\"/>","layout-dashboard":"<path d=\\"M5 4h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1\\"/><path d=\\"M5 16h4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1\\"/><path d=\\"M15 12h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1\\"/><path d=\\"M15 4h4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1\\"/>","pencil":"<path d=\\"M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4\\"/><path d=\\"M13.5 6.5l4 4\\"/>","bug":"<path d=\\"M9 9v-1a3 3 0 0 1 6 0v1\\"/><path d=\\"M8 9h8a6 6 0 0 1 1 3v3a5 5 0 0 1 -10 0v-3a6 6 0 0 1 1 -3\\"/><path d=\\"M3 13l4 0\\"/><path d=\\"M17 13l4 0\\"/><path d=\\"M12 20l0 -6\\"/><path d=\\"M4 19l3.35 -2\\"/><path d=\\"M20 19l-3.35 -2\\"/><path d=\\"M4 7l3.75 2.4\\"/><path d=\\"M20 7l-3.75 2.4\\"/>","play-bug":"<path d=\\"M3.5 18a2.5 3 0 1 0 5 0a2.5 3 0 1 0 -5 0\\"/><path d=\\"M2 18h1.5\\"/><path d=\\"M8.5 18h1.5\\"/><path d=\\"M9.5 14.5l-1.5 1.5\\"/><path d=\\"M2.5 14.5l1.5 1.5\\"/><path d=\\"M2.5 21.5l1.5 -1.5\\"/><path d=\\"M8 20l1.5 1.5\\"/><path d=\\"M13 16l8 -5l-13 -8v8\\"/>","player-pause":"<path d=\\"M6 5m0 1a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v12a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1z\\"/><path d=\\"M14 5m0 1a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v12a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1z\\"/>","player-play":"<path d=\\"M7 4v16l13 -8l-13 -8\\"/>","player-stop":"<path d=\\"M5 7a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2l0 -10\\"/>","plus":"<path d=\\"M12 5l0 14\\"/><path d=\\"M5 12l14 0\\"/>","refresh":"<path d=\\"M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4\\"/><path d=\\"M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4\\"/>","search":"<path d=\\"M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\\"/><path d=\\"M21 21l-6 -6\\"/>","server-2":"<path d=\\"M3 7a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-2\\"/><path d=\\"M3 15a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3l0 -2\\"/><path d=\\"M7 8l0 .01\\"/><path d=\\"M7 16l0 .01\\"/><path d=\\"M11 8h6\\"/><path d=\\"M11 16h6\\"/>","settings":"<path d=\\"M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065\\"/><path d=\\"M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\\"/>","terminal-2":"<path d=\\"M8 9l3 3l-3 3\\"/><path d=\\"M13 15l3 0\\"/><path d=\\"M3 6a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -12\\"/>","trash":"<path d=\\"M4 7l16 0\\"/><path d=\\"M10 11l0 6\\"/><path d=\\"M14 11l0 6\\"/><path d=\\"M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12\\"/><path d=\\"M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3\\"/>"};

/**
 * Full inline svg for a catalog glyph. size is CSS px (default 16); cls is an
 * optional extra class beside .k-icon. Unknown name → '' — never a throw.
 */
function karstIcon(name, size, cls) {
  var paths = KARST_TABLER_ICONS[name];
  if (!paths) return '';
  size = size || 16;
  var k = 'k-icon' + (cls ? ' ' + cls : '');
  return '<svg class="' + k + '" width="' + size + '" height="' + size
    + '" viewBox="0 0 24 24" aria-hidden="true" focusable="false">'
    + paths + '</svg>';
}

  const vscode = acquireVsCodeApi();
  const post = (msg) => vscode.postMessage(msg);
  const el = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));

  let lastState = null;
  // Which chart series the user has muted — LOCAL presentation, never a post.
  const muted = { cpu: false, rss: false };

  // Sort state for the two tables — LOCAL presentation, never a post.
  // Cycle: default (null) → asc → desc → default.
  const sortState = {
    attr: { key: null, dir: null },
    unknown: { key: null, dir: null },
  };

  const ATTR_COLS = [
    { key: 'ticket', label: 'Ticket', num: false, accessor: (r) => (r.ticketKey || r.ticketTitle || '').toLowerCase() },
    { key: 'label', label: 'Repo / label', num: false, accessor: (r) => (r.label || '').toLowerCase() },
    { key: 'pid', label: 'PID', num: true, accessor: (r) => r.pid },
    { key: 'cpu', label: 'CPU', num: true, accessor: (r) => r.cpuPct ?? -1 },
    { key: 'rss', label: 'RSS', num: true, accessor: (r) => r.rssBytes },
    { key: 'procs', label: 'Procs', num: true, accessor: (r) => r.procCount },
    { key: 'up', label: 'Up', num: true, accessor: (r) => r.uptimeMs ?? -1 },
    { key: 'attribution', label: 'Attribution', num: false, accessor: (r) => (r.attribution || '').toLowerCase() },
  ];

  const UNK_COLS = [
    { key: 'pid', label: 'PID', num: true, cls: 'pid', accessor: (r) => r.pid },
    { key: 'cmd', label: 'Command', num: false, cls: 'cmd', accessor: (r) => (r.comm || '').toLowerCase() },
    { key: 'cpu', label: 'CPU', num: true, cls: 'amt', accessor: (r) => r.cpuPctDisplay === '—' ? -1 : parseFloat(r.cpuPctDisplay) || -1 },
    { key: 'rss', label: 'RSS', num: true, cls: 'amt', accessor: (r) => {
      const m = (r.rssDisplay || '').match(/^([\\d.]+)\\s*(B|KB|MB|GB)$/);
      if (!m) return -1;
      const n = parseFloat(m[1]);
      const u = m[2];
      return u === 'B' ? n : u === 'KB' ? n * 1024 : u === 'MB' ? n * 1024 ** 2 : n * 1024 ** 3;
    }},
    { key: 'procs', label: 'Procs', num: true, cls: 'amt', accessor: (r) => r.procCount },
  ];

  const sortRows = (rows, cols, state) => {
    if (!state.key || !state.dir) return rows;
    const col = cols.find((c) => c.key === state.key);
    if (!col) return rows;
    const dir = state.dir === 'asc' ? 1 : -1;
    return [...rows].sort((a, b) => {
      const va = col.accessor(a);
      const vb = col.accessor(b);
      if (va === vb) return 0;
      if (va === -1) return 1;
      if (vb === -1) return -1;
      if (typeof va === 'string') return va.localeCompare(vb) * dir;
      return (va - vb) * dir;
    });
  };

  const statCard = (label, value, note, flag) =>
    \`<div class="stat\${flag ? ' flag' : ''}"><div class="k">\${esc(label)}</div>\` +
    \`<div class="v">\${esc(value)}</div><div class="n">\${esc(note || '')}</div></div>\`;

  const renderStats = (state) => {
    const measuring = state.history.length === 0;
    el('stats').innerHTML = [
      statCard('Attributed CPU', state.cpuPctDisplay, measuring ? 'measuring' : 'of total capacity, rolling'),
      statCard('Attributed RSS', state.rssDisplay, measuring ? 'measuring' : 'resident set size'),
      statCard('Proven waste', String(state.wasteCount), state.wasteCount === 1 ? 'finding' : 'findings', state.wasteCount > 0),
    ].join('');
    el('summaryMeta').textContent =
      \`\${state.attributedRoots} attributed roots · \${state.unattributedShown} unattributed shown\`;
  };

  const renderSpark = (state) => {
    const history = state.history;
    const svg = el('spark');
    if (history.length === 0) {
      svg.innerHTML = '<text x="4" y="45" class="spark-empty">measuring\\u2026</text>';
    } else {
      const W = 560, H = 80, PAD = 2;
      const rss = history.map((s) => s.totals.rssBytes);
      const cpu = history.map((s) => s.totals.cpuPct);
      const rssMax = Math.max(...rss, 1);
      const cpuVals = cpu.filter((v) => v !== null);
      const cpuMax = Math.max(...cpuVals, 1);
      const x = (i) => (history.length === 1 ? PAD : (i / (history.length - 1)) * (W - PAD * 2) + PAD);
      const y = (v, max) => H - PAD - (v / max) * (H - PAD * 2);
      const rssPts = rss.map((v, i) => \`\${x(i)},\${y(v, rssMax)}\`).join(' ');
      const cpuPts = [];
      cpu.forEach((v, i) => { if (v !== null) cpuPts.push(\`\${x(i)},\${y(v, cpuMax)}\`); });
      // Gridlines sit exactly on the host-computed y-tick fractions, so each
      // line and its label always agree — one source of truth for the heights.
      const grid = state.trend.yTicks.map((t) => {
        const gy = y(t.fraction * rssMax, rssMax);
        return \`<line class="gridline" x1="0" y1="\${gy}" x2="\${W}" y2="\${gy}"/>\`;
      }).join('');
      svg.innerHTML = grid +
        \`<polyline vector-effect="non-scaling-stroke" class="series-rss\${muted.rss ? ' muted' : ''}" points="\${rssPts}"></polyline>\` +
        (cpuPts.length ? \`<polyline vector-effect="non-scaling-stroke" class="series-cpu\${muted.cpu ? ' muted' : ''}" points="\${cpuPts}"></polyline>\` : '');
    }
    // Scale markers: the per-series maxima, the y-axis gridline labels, and the
    // x-axis time ticks. Every value is pre-formatted host-side (UI-R31).
    el('chartScale').innerHTML =
      \`<span class="cpu">CPU \${esc(state.trend.cpuMaxDisplay)}</span>\` +
      \`<span class="rss">RSS \${esc(state.trend.rssMaxDisplay)}</span>\`;
    el('chartY').innerHTML = state.trend.yTicks.map((t) => {
      // The gridline is drawn in SVG viewBox space (H=80, PAD=2); the label must
      // sit on the same line, so its top% uses the SAME mapping as the gridline.
      const ySvg = 80 - 2 - t.fraction * (80 - 2 * 2);
      const topPct = Math.round((ySvg / 80) * 100);
      return \`<span class="yTick" style="top:\${topPct}%">\` +
        \`<span class="cpu\${muted.cpu ? ' muted' : ''}">\${esc(t.cpu)}</span>\` +
        \`<span class="rss\${muted.rss ? ' muted' : ''}">\${esc(t.rss)}</span>\` +
      '</span>';
    }).join('');
    el('chartTicks').innerHTML = state.trend.timeTicks.map((t) =>
      \`<span style="left:\${Math.round(t.fraction * 100)}%">\${esc(t.label)}</span>\`,
    ).join('');
  };

  const renderAttributed = (rows) => {
    el('attrCount').textContent = rows.length;
    const sorted = sortRows(rows, ATTR_COLS, sortState.attr);
    // Render header with sort buttons — UI-R09: a real button, not a click on <th>.
    el('attrHead').querySelector('tr').innerHTML = ATTR_COLS.map((c) => {
      const cls = c.num ? ' class="num"' : '';
      const ariaSort = sortState.attr.key === c.key
        ? (sortState.attr.dir === 'asc' ? ' aria-sort="ascending"' : ' aria-sort="descending"')
        : '';
      const arrow = sortState.attr.key === c.key ? (sortState.attr.dir === 'asc' ? ' \\u25B2' : ' \\u25BC') : '';
      return \`<th\${cls}\${ariaSort}><button type="button" class="k-btn k-btn--link" data-sort="\${esc(c.key)}">\${esc(c.label)}\${arrow}</button></th>\`;
    }).join('');
    for (const btn of el('attrHead').querySelectorAll('[data-sort]')) {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort;
        const cur = sortState.attr;
        if (cur.key === key) {
          cur.dir = cur.dir === null ? 'asc' : cur.dir === 'asc' ? 'desc' : null;
          if (cur.dir === null) cur.key = null;
        } else {
          cur.key = key;
          cur.dir = 'asc';
        }
        if (lastState) render(lastState);
      });
    }
    el('attrBody').innerHTML = sorted.map((r) => {
      const ticket = r.ticketKey || r.ticketTitle
        ? \`<div class="ticketCell"><span class="tkey">\${esc(r.ticketKey || '')}</span><span class="ttitle">\${esc(r.ticketTitle || '')}</span></div>\`
        : '<div class="ticketCell"><span class="baseline">baseline</span></div>';
      return '<tr>' +
        \`<td>\${ticket}</td>\` +
        \`<td class="ellipsis">\${esc(r.label || '—')}</td>\` +
        \`<td class="num">\${esc(r.pid)}</td>\` +
        \`<td class="num">\${esc(r.cpuPctDisplay)}</td>\` +
        \`<td class="num">\${esc(r.rssDisplay)}</td>\` +
        \`<td class="num">\${esc(r.procCount)}</td>\` +
        \`<td class="num">\${esc(r.uptimeDisplay || '—')}</td>\` +
        \`<td><span class="attrib">\${esc(r.attribution)}</span></td>\` +
      '</tr>';
    }).join('');
  };

  const renderUnknown = (rows) => {
    el('unknownCount').textContent = rows.length;
    const sorted = sortRows(rows, UNK_COLS, sortState.unknown);
    el('unkHead').querySelector('tr').innerHTML = UNK_COLS.map((c) => {
      const cls = c.num ? ' num' : '';
      const ariaSort = sortState.unknown.key === c.key
        ? (sortState.unknown.dir === 'asc' ? ' aria-sort="ascending"' : ' aria-sort="descending"')
        : '';
      const arrow = sortState.unknown.key === c.key ? (sortState.unknown.dir === 'asc' ? ' \\u25B2' : ' \\u25BC') : '';
      return \`<th class="\${esc(c.cls)}\${cls}"\${ariaSort}><button type="button" class="k-btn k-btn--link" data-sort="\${esc(c.key)}">\${esc(c.label)}\${arrow}</button></th>\`;
    }).join('');
    for (const btn of el('unkHead').querySelectorAll('[data-sort]')) {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort;
        const cur = sortState.unknown;
        if (cur.key === key) {
          cur.dir = cur.dir === null ? 'asc' : cur.dir === 'asc' ? 'desc' : null;
          if (cur.dir === null) cur.key = null;
        } else {
          cur.key = key;
          cur.dir = 'asc';
        }
        if (lastState) render(lastState);
      });
    }
    el('unknownBody').innerHTML = sorted.map((u) =>
      '<tr>' +
        \`<td class="num pid">\${esc(u.pid)}</td>\` +
        \`<td class="ellipsis cmd">\${esc(u.comm)}</td>\` +
        \`<td class="num amt">\${esc(u.cpuPctDisplay)}</td>\` +
        \`<td class="num amt">\${esc(u.rssDisplay)}</td>\` +
        \`<td class="num amt">\${esc(u.procCount)}</td>\` +
      '</tr>',
    ).join('');
    // The lane is machine-wide by construction — these are NOT claimed as karst's.
    el('unknownNote').textContent = rows.length
      ? 'Largest processes not tied to karst, machine-wide — listed for awareness, never claimed.'
      : 'No unattributed heavy processes at the moment.';
  };

  const renderWaste = (rows) => {
    el('wasteCount').textContent = rows.length;
    const wrap = el('waste');
    if (!rows.length) {
      wrap.innerHTML = '<div class="meta">nothing leaked</div>';
      return;
    }
    wrap.innerHTML = rows.map((w) => {
      const action = w.killable
        ? \`<button type="button" class="k-btn k-btn--danger" data-kill="\${esc(w.serverId)}">Stop</button>\`
        : '<span class="why">report-only \\u2014 karst cannot prove this process is safe to stop</span>';
      return '<div class="wrow">' +
        \`<span class="reason" title="\${esc(w.reason)}">\${esc(w.reason)}</span>\` +
        \`<span class="amt">\${esc(w.rssDisplay)}</span>\${action}\` +
      '</div>';
    }).join('');
    for (const btn of wrap.querySelectorAll('[data-kill]')) {
      karstAction(btn, (requestId) => post({ type: 'kill-server', serverId: Number(btn.dataset.kill), requestId }));
    }
  };

  const renderDisk = (rows) => {
    el('diskCount').textContent = rows.length;
    el('diskHint').textContent = rows.length ? 'measured on demand, cached 60 minutes' : 'measured only while this panel is open';
    // The bar width is a RELATIVE share of the largest measured worktree —
    // presentation geometry, derived here from the bytes the host sent.
    const max = Math.max(...rows.map((d) => d.bytes), 1);
    el('diskRows').innerHTML = rows.map((d) => {
      const share = Math.round((d.bytes / max) * 100);
      return '<div class="drow">' +
        '<div>' +
          \`<div class="path" title="\${esc(d.display)}">\${esc(d.display)}</div>\` +
          \`<div class="diskTrack"><i style="width:\${share}%"></i></div>\` +
        '</div>' +
        \`<div class="amt">\${esc(d.sizeDisplay)}</div>\` +
      '</div>';
    }).join('');
  };

  const renderFacts = (facts) => {
    el('facts').innerHTML = facts.map((f) => {
      const attn = f.label === 'Recent CPU' && f.value === 'rising' ? ' attn' : '';
      return '<div class="factRow">' +
        \`<span class="factLabel">\${esc(f.label)}</span>\` +
        \`<span class="factValue\${attn}">\${esc(f.value)}</span>\` +
      '</div>';
    }).join('');
  };

  const render = (state) => {
    if (!state) return;
    lastState = state;
    el('unsupported').classList.toggle('hidden', state.supported);
    el('degraded').classList.toggle('hidden', !state.degraded);
    el('body').classList.toggle('hidden', !state.supported);
    el('sub').textContent = state.supported ? state.scopeLabel : 'not supported on this platform';
    if (!state.supported) return;

    el('live').textContent = \`Live · \${state.sampleAgeDisplay} · 5-minute window · not persisted\`;
    renderStats(state);
    el('trendCount').textContent = \`\${state.history.length} / \${state.historyMax} samples\`;
    renderSpark(state);
    el('scaleNote').textContent = 'derived CPU · resident memory';
    renderAttributed(state.rows);
    renderUnknown(state.unknown);
    renderWaste(state.waste);
    renderDisk(state.disk);
    renderFacts(state.facts);
  };

  // Legend toggles mute a series locally — pure presentation, never a post.
  // \`on\` is the OLD pressed state: a series that was shown becomes muted, so
  // muted mirrors the old aria-pressed — NOT its inverse, which would leave the
  // button grayed while the series stayed visible (and vice versa).
  for (const btn of document.querySelectorAll('.legendBtn')) {
    btn.addEventListener('click', () => {
      const series = btn.dataset.series;
      const on = btn.getAttribute('aria-pressed') === 'true';
      btn.setAttribute('aria-pressed', String(!on));
      muted[series] = on;
      if (lastState) renderSpark(lastState);
    });
  }

  window.addEventListener('message', (e) => {
    const msg = e.data;
    if (!msg) return;
    if (msg.type === 'state') render(msg.state);
    else if (msg.type === 'disk') {
      // Incremental disk rows; re-render from the last state plus the new rows.
      if (lastState) render({ ...lastState, disk: msg.rows });
    } else if (msg.type === 'action-result') karstSettle(msg.requestId, msg.ok, msg.message);
  });

  karstAction(el('refreshBtn'), (requestId) => post({ type: 'refresh', requestId }));
  karstAction(el('measureBtn'), (requestId) => post({ type: 'measure-disk', requestId }));

  // The host pushes on open, but a webview that was restored (or reloaded)
  // missed it — ask, rather than render a blank page.
  post({ type: 'request-state' });
</script>

