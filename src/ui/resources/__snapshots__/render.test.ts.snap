          <div class="chartY" id="chartY"></div>
          <div class="chartScale" id="chartScale"><span class="cpu">CPU —</span><span class="rss">RSS —</span></div>
          <div class="chartTicks" id="chartTicks"></div>
        </div>
      </div>
    </div>

    <div class="panel">
