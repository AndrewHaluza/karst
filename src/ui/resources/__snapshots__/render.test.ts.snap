      <div class="pbody">
        <div class="trendHead">
          <div class="legend" id="legend">
            <button type="button" class="legendBtn" data-series="cpu" aria-pressed="true"><i class="swatch swCpu"></i>CPU %</button>
            <button type="button" class="legendBtn" data-series="rss" aria-pressed="true"><i class="swatch swRss"></i>RSS</button>
          </div>
          <span class="scaleNote" id="scaleNote">derived CPU · resident memory</span>
        </div>
        <div class="chartWrap">
          <svg id="spark" viewBox="0 0 560 80" preserveAspectRatio="none" aria-hidden="true"><text x="4" y="45" class="spark-empty">measuring…</text></svg>
          <div class="chartY" id="chartY"></div>
          <div class="chartScale" id="chartScale"><span class="cpu">CPU —</span><span class="rss">RSS —</span></div>
          <div class="chartTicks" id="chartTicks"></div>
        </div>
      </div>
    </div>

    <div class="panel">
