  if (entry.minElapsed) cleanup();
  else entry.finish = cleanup; // a shown spinner stays >= KARST_SPINNER_MIN_MS

  if (el && ok === true && entry.tier === 'confirm' && el.classList) {
    el.classList.add('is-success');
    setTimeout(function () {
      if (el.classList) el.classList.remove('is-success');
    }, KARST_CONFIRM_MS);
  }

  if (ok === false) {
    karstToast('error', karstOneLine(message) || 'That action failed.');
  } else if (ok === null) {
    karstToast('warning', karstOneLine(message) || 'Still running — the result is unknown.');
  } else if (entry.tier === 'confirm') {
    karstToast('success', karstOneLine(message) || 'Done');
  } else if (message) {
    karstToast('success', karstOneLine(message));
  }
}

/**
 * Bind a control to an async action. \`send\` receives the requestId and is
 * responsible for posting it to the host; the host replies once with
 * { type: 'action-result', requestId, ok, message } and the webview's message
 * handler calls karstSettle. opts.tier is 'view' | 'mutation' | 'confirm';
 * mutation is the default, so a quiet tier is always an explicit opt-in.
 */
function karstAction(el, send, opts) {
  if (!el) return;
  var options = opts || {};
  var tier = options.tier === 'view' || options.tier === 'confirm' ? options.tier : 'mutation';
  el.addEventListener('click', function (ev) {
    if (karstIsPending(el)) {
      // Dropped, not queued (UI-R12).
      if (ev && ev.preventDefault) ev.preventDefault();
      return;
    }
    if (el.disabled) return;
    var requestId = karstRequestId();
    karstBeginPending(el, requestId, tier);
    try {
      send(requestId, ev);
    } catch (err) {
      karstSettle(requestId, false, err && err.message ? err.message : String(err));
    }
    if (options.settle === 'immediate') karstSettle(requestId, true);
  });
}

/** The one polite live region per webview (UI-R27). Created on first use. */
function karstToastRoot() {
  var root = document.getElementById('k-toast-root');
  if (root) return root;
  root = document.createElement('div');
  root.setAttribute('id', 'k-toast-root');
  root.setAttribute('class', 'k-toast-root');
  root.setAttribute('role', 'status');
  root.setAttribute('aria-live', 'polite');
  document.body.appendChild(root);
  return root;
}

var KARST_TOAST_MARKS = {
  error: { glyph: '\\u2715', word: 'Error:' },
  warning: { glyph: '!', word: 'Warning:' },
  success: { glyph: '\\u2713', word: 'Done:' },
  info: { glyph: 'i', word: 'Info:' }
};
var karstToasts = [];

function karstToastPart(tag, cls, text) {
  var el = document.createElement(tag);
  el.classList.add(cls);
  if (text) el.textContent = text;
  return el;
}

/** Remove one toast and clear its timer. Safe to call twice. */
function karstToastDrop(root, entry) {
  clearTimeout(entry.timer);
  var at = karstToasts.indexOf(entry);
  if (at >= 0) karstToasts.splice(at, 1);
  try { root.removeChild(entry.node); } catch (e) { /* already detached */ }
}

/** (Re)start the dwell: a fresh countdown bar node restarts the CSS animation, the timer takes the same duration. */
function karstToastArm(root, entry) {
  clearTimeout(entry.timer);
  var ms = entry.kind === 'error' ? KARST_TOAST_ERROR_MS : KARST_TOAST_SUCCESS_MS;
  var bar = karstToastPart('span', 'k-toast-bar');
  bar.setAttribute('aria-hidden', 'true');
  bar.setAttribute('style', '--k-toast-ms:' + ms + 'ms');
  if (entry.bar) { try { entry.node.removeChild(entry.bar); } catch (e) { /* gone */ } }
  entry.bar = bar;
  entry.node.appendChild(bar);
  entry.timer = setTimeout(function () { karstToastDrop(root, entry); }, ms);
}

/**
 * Surface a terminal outcome. Every toast has a Dismiss button and a timer:
 * an error dwells TOAST_ERROR_MS, the rest TOAST_SUCCESS_MS. Hover or focus
 * pauses the timer; leaving restarts the full time. At most KARST_MAX_TOASTS
 * stay; the same kind and text replaces the one on screen.
 */
function karstToast(kind, message) {
  var text = karstOneLine(message);
  if (!text) return null;
  var root = karstToastRoot();
  var mark = KARST_TOAST_MARKS[kind] || KARST_TOAST_MARKS.info;
  karstToasts.slice().forEach(function (e) {
    if (e.kind === kind && e.text === text) karstToastDrop(root, e);
  });
  while (karstToasts.length >= KARST_MAX_TOASTS) karstToastDrop(root, karstToasts[0]);
  var node = document.createElement('div');
  node.classList.add('k-toast');
  node.classList.add('k-toast--' + kind);
  node.setAttribute('title', text);
  var glyph = karstToastPart('span', 'k-toast-glyph', mark.glyph);
  glyph.setAttribute('aria-hidden', 'true');
  node.appendChild(glyph);
  node.appendChild(karstToastPart('span', 'k-toast-sr', mark.word));
  node.appendChild(karstToastPart('span', 'k-toast-text', text));
  var close = karstToastPart('button', 'k-toast-close', '\\u00d7');
  close.setAttribute('type', 'button');
  close.setAttribute('aria-label', 'Dismiss');
  node.appendChild(close);
  var entry = { node: node, kind: kind, text: text, timer: null, bar: null };
  close.addEventListener('click', function () { karstToastDrop(root, entry); });
  var pause = function () { clearTimeout(entry.timer); };
  var restart = function () { karstToastArm(root, entry); };
  node.addEventListener('mouseenter', pause);
  node.addEventListener('focusin', pause);
  node.addEventListener('mouseleave', restart);
  node.addEventListener('focusout', restart);
  karstToasts.push(entry);
  root.appendChild(node);
  karstToastArm(root, entry);
  return node;
}

/**
 * VS Code's webview host script (pre/index.html, handleInnerClick) listens for
 * 'click' on the iframe WINDOW in the bubble phase. For an anchor whose href is
 * exactly "#" it calls window.scrollTo(0, 0) and does not check
 * event.defaultPrevented, so a handler's preventDefault() cannot stop it.
 * Host-mediated links are written <a href="#">, so each click scrolled the page
 * to the top. This document-level bubble listener runs after the element and
 * React-root handlers, then stops the event before it reaches the window.
 */
document.addEventListener('click', function (ev) {
  var t = ev.target;
  if (t && typeof t.closest === 'function' && t.closest('a[href="#"]')) {
    ev.preventDefault();
    ev.stopPropagation();
  }
});
