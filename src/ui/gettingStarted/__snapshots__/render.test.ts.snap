d=\\"M12.5 3a17 17 0 0 1 0 18\\"/>","git-branch":"<path d=\\"M7 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M7 6m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M17 6m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M7 8l0 8\\"/><path d=\\"M9 18h6a2 2 0 0 0 2 -2v-5\\"/><path d=\\"M14 14l3 -3l3 3\\"/>","git-pull-request":"<path d=\\"M6 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M6 6m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M18 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M6 8l0 8\\"/><path d=\\"M11 6h5a2 2 0 0 1 2 2v8\\"/><path d=\\"M14 9l-3 -3l3 -3\\"/>","git-pull-request-closed":"<path d=\\"M6 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M6 6m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M18 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M6 8v8\\"/><path d=\\"M18 11v5\\"/><path d=\\"M16 4l4 4m0 -4l-4 4\\"/>","git-pull-request-draft":"<path d=\\"M6 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M6 6m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M18 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M6 8v8\\"/><path d=\\"M18 11h.01\\"/><path d=\\"M18 6h.01\\"/>","arrow-back-up":"<path d=\\"M9 14l-4 -4l4 -4\\"/><path d=\\"M5 10h11a4 4 0 1 1 0 8h-1\\"/>","minus":"<path d=\\"M5 12l14 0\\"/>","loader-2":"<path d=\\"M12 3a9 9 0 1 0 9 9\\"/>","git-merge":"<path d=\\"M7 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M7 6m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M17 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M7 8l0 8\\"/><path d=\\"M7 8a4 4 0 0 0 4 4h4\\"/>","info-circle":"<path d=\\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\\"/><path d=\\"M12 9h.01\\"/><path d=\\"M11 12h1v4h1\\"/>","arrow-left":"<path d=\\"M5 12l14 0\\"/><path d=\\"M5 12l6 6\\"/><path d=\\"M5 12l6 -6\\"/>","arrow-up":"<path d=\\"M12 5l0 14\\"/><path d=\\"M18 11l-6 -6\\"/><path d=\\"M6 11l6 -6\\"/>","download":"<path d=\\"M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2\\"/><path d=\\"M7 11l5 5l5 -5\\"/><path d=\\"M12 4l0 12\\"/>","send":"<path d=\\"M10 14l11 -11\\"/><path d=\\"M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5\\"/>","arrows-down-up":"<path d=\\"M17 3l0 18\\"/><path d=\\"M10 18l-3 3l-3 -3\\"/><path d=\\"M7 21l0 -18\\"/><path d=\\"M20 6l-3 -3l-3 3\\"/>","align-box-center-middle":"<path d=\\"M3 19v-14a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2\\"/><path d=\\"M11 15h2\\"/><path d=\\"M9 12h6\\"/><path d=\\"M10 9h4\\"/>","arrow-autofit-width":"<path d=\\"M4 12v-6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v6\\"/><path d=\\"M10 18h-7\\"/><path d=\\"M21 18h-7\\"/><path d=\\"M6 15l-3 3l3 3\\"/><path d=\\"M18 15l3 3l-3 3\\"/>"};

/**
 * Full inline svg for a catalog glyph. size is CSS px (default 16); cls is an
 * optional extra class beside .k-icon. Unknown name → '' — never a throw.
 */
function karstIcon(name, size, cls) {
  var paths = KARST_TABLER_ICONS[name];
  if (!paths) return '';
  size = size || 16;
  var k = 'k-icon' + (cls ? ' ' + cls : '');
  return '<svg class="' + k + '" width="' + size + '" height="' + size
    + '" viewBox="0 0 24 24" aria-hidden="true" focusable="false">'
    + paths + '</svg>';
}

/**
 * The MOUNTING form of karstIcon, for React islands that may not write markup
 * themselves (settings R-X6). Replaces el's children with the glyph.
 */
function karstIconInto(el, name, size, cls) {
  if (el) el.innerHTML = karstIcon(name, size, cls);
}

      const vscode = acquireVsCodeApi();
      const post = (type, requestId) => vscode.postMessage(requestId ? { type, requestId } : { type });

      const MARKS = {
        done: { icon: 'circle-check', cls: 'gs-mark--done', label: 'Done' },
        todo: { icon: 'circle', cls: 'gs-mark--todo', label: 'To do' },
        missing: { icon: 'alert-triangle', cls: 'gs-mark--missing', label: 'Missing' },
      };

      function markFor(it) {
        if (it.done) return MARKS.done;
        return it.id === 'manifest' ? MARKS.todo : MARKS.missing;
      }

      function glyph(mark) {
        const span = document.createElement('span');
        span.className = 'gs-mark ' + mark.cls;
        span.setAttribute('role', 'img');
        span.setAttribute('aria-label', mark.label);
        span.innerHTML = karstIcon(mark.icon, 16);
        return span;
      }

      const MANIFEST_BUTTONS = {
        'setup-agent': { label: 'Set up with agent', title: 'Start an onboarding setup session', msg: 'setup-agent' },
        'create-manifest': { label: 'Use a starter file', title: 'Write a starter karst.yml to the workspace root', msg: 'create-manifest' },
      };

      function manifestButton(id, primary, enabled) {
        const a = MANIFEST_BUTTONS[id];
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'k-btn item-action ' + (primary ? 'k-btn--primary' : 'k-btn--secondary');
        b.textContent = a.label;
        b.title = a.title;
        if (!enabled) {
          b.disabled = true;
          b.title = 'Install the agent CLI first';
          b.id = 'btn-' + id;
          b.setAttribute('aria-describedby', 'why-manifest');
        } else {
          karstAction(b, (requestId) => post(a.msg, requestId));
        }
        return b;
      }

      function renderManifestActions(li, actions, agentReady) {
        const box = document.createElement('div');
        box.className = 'item-actions';
        const agentOff = (id) => id === 'setup-agent' && !agentReady;
        const hasOff = agentOff(actions.primary) || agentOff(actions.secondary);
        box.append(manifestButton(actions.primary, true, !agentOff(actions.primary)));
        box.append(manifestButton(actions.secondary, false, !agentOff(actions.secondary)));
        li.append(box);
        if (hasOff) {
          const why = document.createElement('p');
          why.className = 'step-desc';
          why.id = 'why-manifest';
          why.textContent = 'Install the agent CLI first. See the setup checklist.';
          li.append(why);
        }
      }

      function renderChecklist(items, manifestActions) {
        const ul = document.getElementById('checklist');
        const focusedId = document.activeElement && document.activeElement.closest
          ? (document.activeElement.closest('li[data-id]') || {}).dataset?.id
          : undefined;
        ul.innerHTML = '';
        document.getElementById('checklist-empty').hidden = items.length > 0;
        if (items.length === 0) return;
        // The host orders the two actions by the agent CLI's readiness (Q5); the page reads it, never recomputes it.
        const agentReady = !!manifestActions && manifestActions.primary === 'setup-agent';
        for (const it of items) {
          const li = document.createElement('li');
          li.dataset.id = it.id;
          const head = document.createElement('div');
          head.className = 'item-head';
          const label = document.createElement('span');
          label.className = 'item-label gs-label';
          label.tabIndex = -1;
          label.textContent = it.label;
          head.append(glyph(markFor(it)), label);
          li.append(head);
          if (it.detail) {
            const d = document.createElement('div');
            d.className = 'detail';
            d.textContent = it.detail;
            li.append(d);
          }
          if (it.id === 'manifest' && !it.done && manifestActions) {
            renderManifestActions(li, manifestActions, agentReady);
          }
          ul.append(li);
        }
        // The re-render removed the focused element: keep focus on the same row (GS-7).
        const active = document.activeElement;
        if (focusedId && (!active || active === document.body)) {
          const row = ul.querySelector('li[data-id="' + focusedId + '"] .item-label');
          if (row) row.focus();
        }
      }

      function asLine(text, extra) {
        const p = document.createElement('p');
        p.className = 'as-line' + (extra ? ' ' + extra : '');
        p.textContent = text;
        return p;
      }

      const AS_MARK = {
        done: { dot: 'k-dot--passed', label: 'Done' },
        open: { dot: 'k-dot--failed', label: 'Open' },
        skipped: { dot: 'k-dot--attention', label: 'Skipped' },
      };

      function renderAgentSetupRow(row) {
        const li = document.createElement('li');
        li.className = 'as-row';
        li.dataset.status = row.status;
        const head = document.createElement('div');
        head.className = 'item-head';
        const mark = AS_MARK[row.status] || AS_MARK.open;
        const dot = document.createElement('span');
        dot.className = 'k-dot ' + mark.dot;
        dot.setAttribute('role', 'img');
        dot.setAttribute('aria-label', mark.label);
        const title = document.createElement('span');
        title.className = 'as-title';
        title.textContent = row.title;
        const tag = document.createElement('span');
        tag.className = 'k-chip as-tag';
        tag.textContent = row.required ? 'required' : 'optional';
        head.append(dot, title, tag);
        li.append(head);
        if (row.status === 'open' && row.detail) {
          const d = document.createElement('div');
          d.className = 'detail';
          d.textContent = row.detail;
          li.append(d);
        }
        return li;
      }

      function renderAgentSetup(view) {
        const body = document.getElementById('as-body');
        const updated = document.getElementById('as-updated');
        body.textContent = '';
        document.getElementById('agent-setup').hidden = !view;
        updated.textContent = view && view.updatedLabel ? 'Updated ' + view.updatedLabel : '';
        if (!view) return;
        if (view.checking) {
          const c = asLine('Checking…');
          c.setAttribute('role', 'status');
          body.append(c);
        }
        if (view.error) {
          const e = asLine('Could not check the agent setup: ' + view.error + ' Use Re-check to try again.', 'as-error');
          e.setAttribute('role', 'alert');
          body.append(e);
        }
        if (view.summary) {
          const track = document.createElement('progress');
          track.className = 'as-track';
          track.max = view.summary.total;
          track.value = view.summary.done;
          track.setAttribute('aria-label', 'Agent setup progress');
          body.append(track);
          body.append(asLine(
            view.summary.done + ' of ' + view.summary.total + ' done · ' + view.summary.skipped +
            ' skipped · ' + view.summary.requiredOpen + ' required open'));
        }
        if (view.noManifest) body.append(asLine(view.noManifest));
        if (view.allRequiredDone) body.append(asLine('All required setup items are done.'));
        if (view.rows.length > 0) {
          const ul = document.createElement('ul');
          ul.id = 'as-list';
          for (const row of view.rows) ul.append(renderAgentSetupRow(row));
          body.append(ul);
        }
      }

      function renderTutorial(steps) {
        const ol = document.getElementById('tutorial');
        ol.innerHTML = '';
        for (const s of steps) {
          const li = document.createElement('li');
          const body = document.createElement('div');
          body.className = 'step-body';
          const label = document.createElement('div');
          label.className = 'step-label';
          if (s.done) label.append(glyph(MARKS.done));
          const text = document.createElement('span');
          text.className = 'gs-step-label';
          text.textContent = s.label;
          label.append(text);
          const desc = document.createElement('div');
          desc.className = 'step-desc';
          desc.textContent = s.description;
          body.append(label, desc);
          const ACTIONS = {
            settings: { label: 'Open settings', title: 'Open the Karst settings panel', msg: 'open-settings' },
            'create-ticket': { label: 'Create ticket', title: 'Open the create-ticket panel', msg: 'create-ticket' },
          };
          if (s.action && ACTIONS[s.action]) {
            const a = ACTIONS[s.action];
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'k-btn k-btn--sm step-action ' + (s.done ? 'k-btn--ghost' : 'k-btn--secondary');
            b.textContent = a.label;
            b.title = a.title;
            karstAction(b, (requestId) => post(a.msg, requestId));
            body.append(b);
          }
          li.append(body);
          ol.append(li);
        }
      }

      let recheckId = null;
      function setBusy(on) {
        document.getElementById('checklist').setAttribute('aria-busy', on ? 'true' : 'false');
      }

      window.addEventListener('message', (event) => {
        const msg = event.data;
        if (msg.type === 'state') {
          document.getElementById('state-error').hidden = true;
          document.getElementById('progress').textContent = msg.state.progressText;
          document.getElementById('lede').textContent = msg.state.lede;
          renderChecklist(msg.state.checklist, msg.state.manifestActions);
          renderAgentSetup(msg.state.agentSetup);
          renderTutorial(msg.state.tutorial);
        } else if (msg.type === 'state-error') {
          const n = document.getElementById('state-error');
          n.textContent = 'Could not check your setup: ' + msg.message + '. Select Re-check to try again.';
          n.hidden = false;
          document.getElementById('checklist').querySelectorAll('.gs-pending').forEach((el) => el.remove());
        } else if (msg.type === 'action-result') {
          if (msg.requestId === recheckId) { recheckId = null; setBusy(false); }
          karstSettle(msg.requestId, msg.ok, msg.message);
        }
      });

      karstAction(document.getElementById('recheck'), (requestId) => { recheckId = requestId; setBusy(true); post('recheck-deps', requestId); }, { tier: 'view' });
      karstAction(document.getElementById('report-issue'), (requestId) => post('report-issue', requestId));
      karstAction(document.getElementById('dismiss'), (requestId) => post('dismiss', requestId), { tier: 'view' });
      post('request-state');
    </script>
  

"
`;

