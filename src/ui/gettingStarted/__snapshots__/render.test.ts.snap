            view.summary.done + ' of ' + view.summary.total + ' done · ' + view.summary.skipped +
            ' skipped · ' + view.summary.requiredOpen + ' required open'));
        }
        if (view.noManifest) body.append(asLine(view.noManifest));
        if (view.allRequiredDone) body.append(asLine('All required setup items are done.'));
        if (view.rows.length > 0) {
          const ul = document.createElement('ul');
          ul.id = 'as-list';
          for (const row of view.rows) ul.append(renderAgentSetupRow(row));
          body.append(ul);
        }
      }

      function renderTutorial(steps) {
        const ol = document.getElementById('tutorial');
        ol.innerHTML = '';
        for (const s of steps) {
          const li = document.createElement('li');
          const body = document.createElement('div');
          body.className = 'step-body';
          const label = document.createElement('div');
          label.className = 'step-label';
          if (s.done) label.append(glyph(MARKS.done));
          const text = document.createElement('span');
          text.className = 'gs-step-label';
          text.textContent = s.label;
          label.append(text);
          const desc = document.createElement('div');
          desc.className = 'step-desc';
          desc.textContent = s.description;
          body.append(label, desc);
          const ACTIONS = {
            settings: { label: 'Open settings', title: 'Open the Karst settings panel', msg: 'open-settings' },
            'create-ticket': { label: 'Create ticket', title: 'Open the create-ticket panel', msg: 'create-ticket' },
          };
          if (s.action && ACTIONS[s.action]) {
            const a = ACTIONS[s.action];
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'k-btn k-btn--sm step-action ' + (s.done ? 'k-btn--ghost' : 'k-btn--secondary');
            b.textContent = a.label;
            b.title = a.title;
            karstAction(b, (requestId) => post(a.msg, requestId));
            body.append(b);
