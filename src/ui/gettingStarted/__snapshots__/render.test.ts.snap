        <circle cx="106.5" cy="111.5" r="26.5" fill="url(#gsCore)"></circle>
      </svg>
      <h1>Getting Started</h1>
    </div>
    <p class="lede">Orchestrate AI-agent ticket workflows across your repos. Finish setup below.</p>

    <section>
      <h2>Setup checklist</h2>
      <ul id="checklist"></ul>
      <div class="toolbar">
        <button type="button" class="k-btn k-btn--secondary" id="recheck" title="Re-run the setup checklist against disk and PATH">Re-check</button>
      </div>
    </section>

    <section>
      <h2>How Karst works</h2>
      <ul class="steps" id="tutorial"><li><div class="step-body"><div>Configure repositories &amp; agent provider</div><div class="step-desc">Open Settings to point each repository at its path and pick your agent CLI.</div><button type="button" class="k-btn k-btn--secondary k-btn--sm step-action" title="Open the Karst settings panel">Open Settings</button></div></li><li><div class="step-body"><div>Create your first ticket</div><div class="step-desc">Describe the work; Karst fetches or drafts the context brief.</div><button type="button" class="k-btn k-btn--secondary k-btn--sm step-action" title="Open the create-ticket panel">Create Ticket</button></div></li><li><div class="step-body"><div>Pick repos + approach and launch the session</div><div class="step-desc">Choose which repositories are in scope and how the agent should work, then start.</div></div></li><li><div class="step-body"><div>Watch stage progress on the ticket dashboard</div><div class="step-desc">Open a ticket to follow it through scope → impl → uat as the agent runs.</div></div></li><li><div class="step-body"><div>Optional: install an approach package</div><div class="step-desc">Add a curated method (agents, commands, skills) from Settings → Approaches.</div><button type="button" class="k-btn k-btn--secondary k-btn--sm step-action" title="Open the Karst settings panel">Open Settings</button></div></li></ul>
    </section>

    <section>
      <h2>Report an issue</h2>
      <p class="section-desc">
        Click this when Karst itself behaves unexpectedly — a ticket stuck at a stage, a gate
        that will not run, a panel that goes blank. Karst collects its own diagnostics
        (runtime versions, stage and gate state, effective configuration, bounded logs),
        redacts secrets, paths and credentials, then opens the report for you to read
        before anything leaves your machine. Approve it and Karst hands the redacted
        summary to a prefilled GitHub issue in your browser; you still press Submit there.
      </p>
      <p class="section-desc">
        Ticket descriptions and other prompt text are left out unless you opt in during the
        review step. For work items in your own project, create a ticket instead.
      </p>
      <div class="toolbar">
        <button type="button" class="k-btn k-btn--secondary" id="report-issue" title="Collect redacted Karst diagnostics and open a prefilled GitHub issue">Report an issue</button>
      </div>
    </section>

    <footer>
      <button type="button" class="k-btn k-btn--ghost" id="dismiss">Don't show this again</button>
    </footer>

    <script nonce="fixture-nonce-000000000000">
  // ── Karst design system runtime (docs/ui/DESIGN-SYSTEM.md §5) ────────────────
var KARST_WATCHDOG_MS = 45000;
var KARST_FLASH_DONE_MS = 2400;
var KARST_TOAST_SUCCESS_MS = 6000;
var KARST_MAX_TOAST_CHARS = 240;

/** requestId -> { el, timer, wasDisabled }. The single source of "what is in flight". */
var karstPending = {};
var karstReqSeq = 0;

function karstRequestId() {
  karstReqSeq = karstReqSeq + 1;
  return 'k' + karstReqSeq + '-' + karstReqSeq.toString(36);
}

/** Untrusted prose (CLI output, model output, git stderr) collapsed to one capped line. */
function karstOneLine(value) {
  var s = String(value === null || value === undefined ? '' : value).replace(/\\s+/g, ' ').trim();
  return s.length > KARST_MAX_TOAST_CHARS ? s.slice(0, KARST_MAX_TOAST_CHARS - 1) + '…' : s;
}

/** HTML-escape untrusted text before it lands in an innerHTML template literal. */
var KARST_ESCAPES = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
function karstEsc(value) {
