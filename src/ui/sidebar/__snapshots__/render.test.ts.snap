 * handler calls karstSettle.
 */
function karstAction(el, send, opts) {
  if (!el) return;
  var options = opts || {};
  el.addEventListener('click', function (ev) {
    if (karstIsPending(el)) {
      // Dropped, not queued (UI-R12).
      if (ev && ev.preventDefault) ev.preventDefault();
