const AGENT_PROVIDER_LABELS = {"claude":"Claude Code","codex":"Codex","antigravity":"Antigravity CLI","opencode":"OpenCode"};
const AGENT_ICONS = {"claude":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path clip-rule=\\"evenodd\\" d=\\"M20.998 10.949H24v3.102h-3v3.028h-1.487V20H18v-2.921h-1.487V20H15v-2.921H9V20H7.488v-2.921H6V20H4.487v-2.921H3V14.05H0V10.95h3V5h17.998v5.949zM6 10.949h1.488V8.102H6v2.847zm10.51 0H18V8.102h-1.49v2.847z\\"></path></svg>","codex":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path clip-rule=\\"evenodd\\" d=\\"M8.086.457a6.105 6.105 0 013.046-.415c1.333.153 2.521.72 3.564 1.7a.117.117 0 00.107.029c1.408-.346 2.762-.224 4.061.366l.063.03.154.076c1.357.703 2.33 1.77 2.918 3.198.278.679.418 1.388.421 2.126a5.655 5.655 0 01-.18 1.631.167.167 0 00.04.155 5.982 5.982 0 011.578 2.891c.385 1.901-.01 3.615-1.183 5.14l-.182.22a6.063 6.063 0 01-2.934 1.851.162.162 0 00-.108.102c-.255.736-.511 1.364-.987 1.992-1.199 1.582-2.962 2.462-4.948 2.451-1.583-.008-2.986-.587-4.21-1.736a.145.145 0 00-.14-.032c-.518.167-1.04.191-1.604.185a5.924 5.924 0 01-2.595-.622 6.058 6.058 0 01-2.146-1.781c-.203-.269-.404-.522-.551-.821a7.74 7.74 0 01-.495-1.283 6.11 6.11 0 01-.017-3.064.166.166 0 00.008-.074.115.115 0 00-.037-.064 5.958 5.958 0 01-1.38-2.202 5.196 5.196 0 01-.333-1.589 6.915 6.915 0 01.188-2.132c.45-1.484 1.309-2.648 2.577-3.493.282-.188.55-.334.802-.438.286-.12.573-.22.861-.304a.129.129 0 00.087-.087A6.016 6.016 0 015.635 2.31C6.315 1.464 7.132.846 8.086.457zm-.804 7.85a.848.848 0 00-1.473.842l1.694 2.965-1.688 2.848a.849.849 0 001.46.864l1.94-3.272a.849.849 0 00.007-.854l-1.94-3.393zm5.446 6.24a.849.849 0 000 1.695h4.848a.849.849 0 000-1.696h-4.848z\\"></path></svg>","antigravity":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path clip-rule=\\"evenodd\\" d=\\"M21.751 22.607c1.34 1.005 3.35.335 1.508-1.508C17.73 15.74 18.904 1 12.037 1 5.17 1 6.342 15.74.815 21.1c-2.01 2.009.167 2.511 1.507 1.506 5.192-3.517 4.857-9.714 9.715-9.714 4.857 0 4.522 6.197 9.714 9.715z\\"></path></svg>","opencode":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path d=\\"M16 6H8v12h8V6zm4 16H4V2h16v20z\\"></path></svg>"};
function agentMeta(p) {
  return Object.prototype.hasOwnProperty.call(AGENT_PROVIDERS, p) ? AGENT_PROVIDERS[p] : null;
}
function agentLabel(p) {
  const id = p || "";
  const meta = agentMeta(id);
  return meta ? meta.label : (id.charAt(0).toUpperCase() + id.slice(1));
}
function agentIconHtml(provider) {
  const meta = agentMeta(provider);
  const icon = meta ? meta.icon : "";
  return icon ? '<span class="agenticon" aria-hidden="true">' + icon + '</span>' : "";
}
function agentBadgeHtml(provider) {
  const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[c]));
  return '<span class="agentbadge">' + agentIconHtml(provider) + '<span class="agentname">' + esc(agentLabel(provider)) + '</span></span>';
}
function agentIdentityHtml(provider, model, compact) {
  const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[c]));
  const p = provider || "";
  const meta = agentMeta(p);
  const icon = meta && meta.icon
    ? '<span class="agent-identity-icon" aria-hidden="true">' + meta.icon + '</span>'
    : "";
  const name = '<span class="agent-identity-name">' + esc(agentLabel(p)) + '</span>';
  const modelHtml = model
    ? '<span class="agent-identity-sep" aria-hidden="true">·</span><span class="agent-identity-model">' + esc(model) + '</span>'
    : "";
  return '<span class="agent-identity' + (compact ? ' compact' : '') + '"' + (p ? ' data-provider="' + esc(p) + '"' : '') + '>'
    + icon + name + modelHtml + '</span>';
}

  const vscode = acquireVsCodeApi();
  const post = (m) => vscode.postMessage(m);
  const el = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) =>
    ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));

  // \`dotVariant\` names a \`.k-dot--<variant>\` suffix (model/designComponents),
  // not the facet's own key — "input" (needs you) maps to the shared
  // "attention" status meaning, "done" to "passed".
  const FACET_META = [
    { key:'all', label:'All', dotVariant:null },
    { key:'running', label:'In progress', dotVariant:'running' },
    { key:'input', label:'Needs you', dotVariant:'attention' },
    { key:'failed', label:'Blocked', dotVariant:'failed' },
    { key:'done', label:'Done', dotVariant:'passed' },
    { key:'archived', label:'Archived', dotVariant:null },
  ];

  // Status word for the glyph's role="img" aria-label — colour is never the
  // only carrier of the ticket's state (UI-R28).
  const GLYPH_WORD = { gray:'Pending', blue:'Running', amber:'Needs you', green:'Done', red:'Failed' };

  // Current state snapshot + which rows are expanded (kept across re-renders).
  // \`facets\` is the multi-select selection (lit chips); \`['all']\` = no filter.
  // The All view renders \`sections\` (Current / Recently Done / Older
  // Completed); the Done facet renders \`done\`; every other facet renders the
  // flat \`rows\`. A pre-upgrade snapshot has no \`sections\` — \`renderAll\` falls
  // back to \`rows\` until the fresh state lands.
  let state = { facets:['all'], filter:'', counts:{}, sections:{current:[],recentlyDone:[],olderDone:[]}, done:[], rows:[] };
  const open = new Set();
  // The shared ticket-actions context window (Edit / Follow Up / Archive).
  // \`menuTicket\` is the ticket whose "⋯" is open — ONE shared fixed popup, so
  // only one row's menu can be open at a time (unlike \`open\`, which allows
  // several rows expanded at once). The trigger element is kept so the window
  // can be positioned at it and focus returned on close. View state, like
  // \`open\` — the host neither knows nor persists it.
  let menuTicket = null;
  let menuTrigger = null;
  // The Older Completed disclosure is VIEW state, never ticket data: the host
  // neither knows nor persists it. \`histUser\` separates an explicit click
  // (which sticks across searches and re-renders) from the automatic search
  // reveal (which must reset to the default collapsed state when the query
  // clears — the doc's "unless the user explicitly expanded history" rule).
  let histOpen = false;
  let histUser = false;

  // Row/toolbar glyphs come from the injected Tabler catalog (docs/ui/ICONS.md
  // §3): \`karstIcon(name, 13)\` renders the shared 24-viewBox stroke treatment
  // at row size. \`mark\` is the one exception — the karst brand mark, a
  // product-identity glyph that Tabler cannot express (§5).
  const chev = karstIcon('chevron-right', 12);
  const ic = {
    dash: karstIcon('layout-dashboard', 13),
    sess: karstIcon('terminal-2', 13),
    spin: karstIcon('player-play', 13),
    edit: karstIcon('pencil', 13),
    arch: karstIcon('archive', 13),
    unarch: karstIcon('history', 13),
    more: karstIcon('dots', 13),
    // Follow-up uses Tabler's corner-down-right — the "carry on from here"
    // arrow — per the follow-up ticket (869ehda7y-fu1).
    follow: karstIcon('corner-down-right', 13),
    // The karst mark (approved #35 silhouette, monochrome for status tint) —
    // the status-tinted row marker.
    mark:'<svg aria-hidden="true" width="13" height="13" viewBox="0 0 215 215" fill="currentColor"><path d="M 96 20 L 25 67 L 25 156 L 98 203 L 98 180 L 44 145 L 44 78 L 97 44 Z"/><path d="M 151 42 L 138 58 L 170 78 L 170 144 L 138 165 L 150 180 L 188 156 L 188 67 Z"/><circle cx="106.5" cy="111.5" r="26.5"/></svg>',
    del: karstIcon('trash', 13),
  };

  function renderFacets() {
    // Multi-select: any number of status chips can be lit at once (their union).
    // \`all\` is lit only when nothing else is; \`aria-pressed\` mirrors the toggle
    // AND drives the chip's "on" look via the primitive's own
    // \`[aria-pressed="true"]\` rule — no local \`.on\` class needed anymore.
    const sel = new Set(state.facets || ['all']);
    el('facets').innerHTML = FACET_META.map((f) => {
      const n = state.counts[f.key] ?? 0;
      const pressed = sel.has(f.key);
      const dot = f.dotVariant
        ? \`<span class="k-dot k-dot--\${f.dotVariant}" aria-hidden="true"></span>\`
        : '';
      return \`<button type="button" class="k-chip" data-facet="\${f.key}" aria-pressed="\${pressed}">\${dot}\${esc(f.label)} <span class="n">\${n}</span></button>\`;
    }).join('');
  }

  // Compact "4m ago" / "2h ago" from an ISO timestamp, against the viewer's
  // clock (the host stores UTC; formatting here keeps the model host-clock-free).
  function relTime(iso) {
    if (!iso) return '';
    const t = Date.parse(iso);
    if (Number.isNaN(t)) return '';
    const s = Math.max(0, Math.round((Date.now() - t) / 1000));
    if (s < 45) return 'just now';
    const m = Math.round(s / 60);
    if (m < 60) return m + 'm ago';
    const h = Math.round(m / 60);
    if (h < 24) return h + 'h ago';
    return Math.round(h / 24) + 'd ago';
  }

  // The activity line is retired with the mini-dashboard: its "what is the
  // session doing" content moved into the host-derived peek summary (peek.ts),
  // which also carries the next action. \`relTime\` stays — the Recently Done
  // rows still show "4m ago".

  function metaLine(row) {
    const ports = (row.servers || []).map((s) => s.port).filter(Boolean);
    const repos = (row.worktrees || []).map((w) => w.repoDisplay || w.repo).filter(Boolean);
    const prs = (row.prs || []).map((p) => p.number).filter((n) => n != null);
    const tokens = [];
    if (row.model) tokens.push(esc(row.model));
    if (repos.length) tokens.push(esc(repos.join('+')));
    if (ports.length) tokens.push(esc(ports.map((p) => ':' + p).join(', ')));
    if (prs.length) tokens.push(esc(prs.map((n) => 'PR #' + n).join(', ')));
    return tokens.join(' · ');
  }

  // The expanded mini-dashboard's quick-action toolbar — the SAME actions the
  // collapsed hover strip shows, moved into the peek head row's top-right (the
  // prototype's peek-tools) so expanding never duplicates them (the hover strip
  // is not rendered while the row is open). Spin is ticket-level and shown for
  // every row; the host command owns the real capability/availability rules.
  // The "⋯" is a trigger for the shared ticket context window (Edit / Follow
  // Up / Archive) — a positioned popup, never the full-width in-flow menu the
  // follow-up retired.
  function toolsHtml(row, sessVerb, menuOpen) {
    return \`<div class="peek-tools">\`
      + \`<button type="button" class="k-iconbtn" data-act="spin" data-id="\${row.ticketId}" aria-label="Spin up worktree and dev servers" title="Spin up worktree and dev servers">\${ic.spin}</button>\`
      + \`<button type="button" class="k-iconbtn" data-act="open-session" data-id="\${row.ticketId}" aria-label="\${sessVerb} session" title="\${sessVerb} session">\${ic.sess}</button>\`
      + \`<button type="button" class="k-iconbtn" data-act="open-dashboard" data-id="\${row.ticketId}" aria-label="Open ticket dashboard" title="Open ticket dashboard">\${ic.dash}</button>\`
      + ctxMenuTriggerHtml(row, menuOpen)
      + \`</div>\`;
  }

  // The shared context window trigger (⋯): a real button with menu semantics
  // (aria-haspopup + aria-expanded). Used BOTH in the collapsed hover strip
  // (which the follow-up reverted to its prior behavior — Spin / Terminal /
  // ⋯, with Edit / Archive back inside the window alongside the new
  // Create follow-up) and in the expanded dashbar.
  function ctxMenuTriggerHtml(row, menuOpen) {
    return \`<button type="button" class="k-iconbtn" data-menu="\${row.ticketId}" aria-expanded="\${menuOpen}" aria-haspopup="menu" aria-label="More ticket actions" title="More ticket actions">\${ic.more}</button>\`;
  }

  // The shared ticket-actions context window: Edit / Create follow-up /
  // Archive, deliberately secondary to the toolbar's Spin / Terminal /
  // Dashboard. One fixed popup (never a full-width in-flow block) positioned at
  // its trigger when opened, so the list's scroll container can never clip it.
  // Create follow-up uses the corner-down-right icon; Archive keeps its danger
  // treatment. The follow-up put ALL THREE in the "⋯" submenu ("both 'Archive'
  // and 'Follow Up' should be accessible via the '...' submenu") — the host
  // command guards the done-only rule itself, so the webview never has to
  // second-guess it.
  function ctxMenuItemsHtml(row) {
    return \`<button type="button" class="ctxitem" data-act="edit" data-id="\${row.ticketId}" role="menuitem" title="Edit ticket">\${ic.edit} Edit ticket</button>\`
      + \`<button type="button" class="ctxitem" data-act="create-follow-up" data-id="\${row.ticketId}" role="menuitem" title="Create a follow-up ticket">\${ic.follow} Create follow-up</button>\`
      + \`<button type="button" class="ctxitem danger" data-act="archive" data-id="\${row.ticketId}" role="menuitem" title="Archive ticket, hiding it from the active list">\${ic.arch} Archive</button>\`;
  }

  // Open the shared context window at the given trigger. Rebuilds the items for
  // that ticket, positions the fixed window at the trigger (flipping above when
  // it would overflow the bottom), and hands focus to the first item.
  function openCtxMenu(trigger, row) {
    const menu = el('ctxMenu');
    if (!menu) return;
    closeCtxMenu(false);
    menuTicket = row.ticketId;
    menuTrigger = trigger;
    menu.innerHTML = ctxMenuItemsHtml(row);
    menu.classList.add('open');
    trigger.setAttribute('aria-expanded', 'true');
    const r = trigger.getBoundingClientRect();
    const w = menu.offsetWidth || 176;
    const left = Math.min(r.left, Math.max(8, window.innerWidth - w - 8));
    const bottom = window.innerHeight - r.bottom;
    menu.style.left = left + 'px';
    menu.style.top = (bottom > 240 ? r.bottom + 4 : Math.max(8, r.top - menu.offsetHeight - 4)) + 'px';
    const first = menu.querySelector('.ctxitem');
    if (first && typeof first.focus === 'function') first.focus();
  }

  function closeCtxMenu(returnFocus) {
    const menu = el('ctxMenu');
    if (!menu || !menu.classList.contains('open')) return;
    menu.classList.remove('open');
    menu.innerHTML = '';
    if (menuTrigger) {
      menuTrigger.setAttribute('aria-expanded', 'false');
      if (returnFocus && typeof menuTrigger.focus === 'function') menuTrigger.focus();
    }
    menuTicket = null;
    menuTrigger = null;
  }

  // The contextual primary next action (peek.ts) — a LABELED primary button,
  // pinned bottom-right in the mini-dashboard's actions bar (distinct from the
  // icon-only top-right tools). \`resolve-conflicts\` carries the conflicted repo
  // so the host can re-verify against the store before opening a session.
  function nextCtaHtml(next, row) {
    switch (next.kind) {
      case 'open-session':
        return \`<button type="button" class="k-btn k-btn--primary" data-act="open-session" data-id="\${row.ticketId}" title="\${esc(next.label)}">\${esc(next.label)}</button>\`;
      case 'create-follow-up':
        return \`<button type="button" class="k-btn k-btn--primary" data-act="create-follow-up" data-id="\${row.ticketId}" title="\${esc(next.label)}">\${esc(next.label)}</button>\`;
      case 'resolve-conflicts':
        return \`<button type="button" class="k-btn k-btn--primary" data-act="resolve-conflicts" data-id="\${row.ticketId}" data-repo="\${esc(next.repo)}" title="\${esc(next.label)}">\${esc(next.label)}</button>\`;
    }
  }

  // The state-specific context rows (prototype v9): who is working (agent
  // identity), how far a running gate is (progress), and the per-repo landing
  // state (PR rows). Each renders only when the host-derived peek carries it.
  function peekAgentHtml(agent) {
    if (!agent || !agent.provider) return '';
    // Compact variant of the shared [icon] Core · Model identity (UI-R10c).
    return \`<div class="peek-agent">\${agentIdentityHtml(agent.provider, agent.model, true)}</div>\`;
  }

  function peekProgressHtml(progress) {
    if (!progress || progress.total <= 0) return '';
    const pct = Math.min(100, Math.round((progress.passed / progress.total) * 100));
    return \`<div class="peek-progress" role="progressbar" aria-label="Gate progress" aria-valuenow="\${progress.passed}" aria-valuemin="0" aria-valuemax="\${progress.total}"><span style="width:\${pct}%"></span></div>\`;
  }

  function peekReposHtml(repos) {
    if (!repos || !repos.length) return '';
    return \`<div class="peek-repos">\`
      + repos.map((r) => {
          const pr = r.number != null ? \`#\${r.number}\` : '';
          const state = r.state === 'conflict'
            ? \`<span class="peek-repo-state conflict">! Conflicts</span>\`
            : \`<span class="peek-repo-state ready">✓ Ready</span>\`;
          return \`<div class="peek-repo">\`
            + (pr ? \`<span class="peek-repo-pr">\${esc(pr)}</span>\` : '')
            + \`<span class="peek-repo-name">\${esc(r.repo)}</span>\${state}</div>\`;
        }).join('')
      + \`</div>\`;
  }

  // One ticket row. \`compact\` switches to the completed-row treatment: check
  // indicator instead of the status glyph, muted title, no stage pill (the
  // section context already says "done"), and — for Recently Done only —
  // the relative completion time. The expanded body, the hover actions and
  // the open/active marks are identical either way: selecting a completed
  // ticket behaves exactly like selecting a Current one.
  function rowHtml(row, opts) {
    opts = opts || {};
    const compact = !!opts.compact;
    const isOpen = open.has(row.ticketId);
    const menuOpen = menuTicket === row.ticketId;
    // A restored snapshot (vscode.getState) can predate stageLabel, so fall
    // back rather than render an empty pill on the first paint after upgrade.
    const stageText = row.stageLabel || row.description || '—';
    // The chip states the STAGE (colored by the shared stg-* token, matching
    // the dashboard rail); the full phrase moves to the tooltip. A pre-upgrade
    // snapshot lacks stageChip/stageClass, so fall back to the phrase + a
    // neutral class rather than render blank.
    const stageChip = row.stageChip || stageText;
    const stageClass = row.stageClass || 'stg-unknown';
    // The session button states which of the two it does — "Continue" a
    // captured interactive session, or "Start" a fresh one. A pre-upgrade
    // snapshot has no sessionAction, so fall back to "Start" rather than an
    // empty verb. The single, always-visible returning-user entry point.
    const sessVerb = (row.sessionAction && row.sessionAction.label) || 'Start';
    const glyphWord = GLYPH_WORD[row.glyph] || 'Unknown';
    const toggleLabel = isOpen ? 'Collapse ticket details' : 'Expand ticket details';

    const acts = row.archived
      ? \`<button type="button" class="k-iconbtn" data-act="unarchive" data-id="\${row.ticketId}" aria-label="Restore ticket to the active list" title="Restore ticket to the active list">\${ic.unarch}</button>\`
        + \`<button type="button" class="k-iconbtn k-iconbtn--danger" data-act="delete" data-id="\${row.ticketId}" aria-label="Delete ticket permanently" title="Delete ticket permanently">\${ic.del}</button>\`
      // The collapsed hover strip reverted to its PRIOR behavior: Spin /
      // Terminal + the ⋯ context-window trigger. Edit / Archive live inside
      // that window (secondary), Dashboard belongs to the expanded toolbar —
      // the follow-up took it out of the hover strip again.
      : \`<button type="button" class="k-iconbtn" data-act="spin" data-id="\${row.ticketId}" aria-label="Spin up worktree and dev servers" title="Spin up worktree and dev servers">\${ic.spin}</button>\`
        + \`<button type="button" class="k-iconbtn" data-act="open-session" data-id="\${row.ticketId}" aria-label="\${sessVerb} session" title="\${sessVerb} session">\${ic.sess}</button>\`
        + ctxMenuTriggerHtml(row, menuOpen);
    // The hover strip is only rendered while the row is COLLAPSED — expanding
    // moves the same quick actions into the mini-dashboard's head-row tools, so
    // the two are never visible at once (no duplicated quick actions).
    const hoverStrip = isOpen ? '' : \`<span class="rowacts">\${acts}</span>\`;

    // The stage-aware mini-dashboard content (peek.ts): head row (strongest
    // summary + the quick-action tools), the state-specific context (agent /
    // progress / landing repos), the meta line, and the pinned bottom-right
    // contextual CTA. Archived rows keep their restore/delete pair instead. A
    // pre-upgrade snapshot has no peek and renders the plain meta only.
    const peek = row.peek;
    const meta = metaLine(row);
    const metaHtml = meta ? \`<div class="meta">\${meta}</div>\` : '';
    const peekHtml = !row.archived && peek
      ? \`<div class="peek">\`
          + \`<div class="peek-head">\`
            + \`<div class="peek-copy">\`
              + \`<div class="peek-title">\${esc(peek.title)}</div>\`
              + (peek.detail ? \`<div class="peek-detail">\${esc(peek.detail)}</div>\` : '')
            + \`</div>\`
            + toolsHtml(row, sessVerb, menuOpen)
          + \`</div>\`
          + peekProgressHtml(peek.progress)
          + \`<div class="peek-sep"></div>\`
          + peekAgentHtml(peek.agent)
          + peekReposHtml(peek.repos)
          + metaHtml
        + \`</div>\`
        + (peek.next ? \`<div class="peek-actions">\${nextCtaHtml(peek.next, row)}</div>\` : '')
      : '';
    const bar = row.archived
      ? \`<div class="actions">\`
          + \`<button type="button" class="k-btn k-btn--secondary" data-act="unarchive" data-id="\${row.ticketId}" title="Restore ticket to the active list">\${ic.unarch} Unarchive</button>\`
          + \`<button type="button" class="k-btn k-btn--danger" data-act="delete" data-id="\${row.ticketId}" title="Delete ticket permanently">\${ic.del} Delete</button>\`
        + \`</div>\`
      : '';

    // Decorative content of the row's main click target — never another
    // interactive control (UI-R09; see the \`.rowopen\` comment in <style>).
    // Completed rows swap the karst mark + status dot for a check-in-ring
    // (aria-hidden — the section header carries the "done" meaning) and
    // drop the stage pill; the check SHAPE is the non-color carrier
    // (UI-R28) and \`g-<glyph>\` keeps the shared status color.
    const glyphHtml = compact
      ? \`<span class="glyph chk g-\${esc(row.glyph)}" aria-hidden="true">\${karstIcon('circle-check', 14)}</span>\`
      : \`<span class="glyph g-\${esc(row.glyph)}" role="img" aria-label="\${esc(glyphWord)}" title="\${esc(row.description)}">\${ic.mark}<span class="sdot" aria-hidden="true"></span><span class="sdot-spin" aria-hidden="true"></span></span>\`;
    const rowContent = glyphHtml
      + \`<span class="name">\${esc(row.label)}</span>\`
      + (row.parentKey ? \`<span class="parentref" title="Follow-up of \${esc(row.parentKey)}">↳ \${esc(row.parentKey)}</span>\` : '')
      + (compact
        ? (opts.time ? \`<span class="time">\${esc(relTime(row.lastActiveAt))}</span>\` : '')
        : \`<span class="stage \${esc(stageClass)}" title="\${esc(stageText)}">\${esc(stageChip)}</span>\`);
    // Archived tickets have no dashboard action, so the wrapper is a plain,
    // non-interactive span rather than a button with nothing to do.
    const openControl = row.archived
      ? \`<span class="rowopen">\${rowContent}</span>\`
      : \`<button type="button" class="k-btn k-btn--link k-btn--row rowopen" data-open="\${row.ticketId}" title="Open ticket dashboard">\${rowContent}</button>\`;

    return \`<div class="ticket\${isOpen ? ' open' : ''}\${row.archived ? ' arch' : ''}\${row.isActive ? ' active' : ''}\${compact ? ' done' : ''}\${opts.older ? ' older' : ''}" data-id="\${row.ticketId}">\`
      + \`<div class="row">\`
      + \`<button type="button" class="k-iconbtn chev" data-toggle="\${row.ticketId}" aria-expanded="\${isOpen}" aria-label="\${toggleLabel}" title="\${toggleLabel}">\${chev}</button>\`
      + openControl
      + hoverStrip
      + \`</div>\`
      + \`<div class="body">\`
      + (() => { const b = row.blocker; if (!b) return '';
          // Only the failure REASON is new — the status ("failed") is already the
          // row's left glyph color, so we never repeat it here.
          const txt = b.reason ? esc(b.reason) : '';
          const att = b.attempt ? \`<span class="att">attempt \${b.attempt}</span>\` : '';
          if (!txt && !att) return '';
          return \`<div class="nextact warn">⚠ \${txt}\${att}</div>\`; })()
      + peekHtml
      + (row.archived ? metaHtml : '')
      + bar
      + \`</div></div>\`;
  }

  // Lightweight section header: "CURRENT · 7" (uppercased + letter-spaced in
  // CSS). The count is what is rendered BELOW it — the host already filtered
  // each section by the query, so the header never promises hidden rows.
  function secHtml(name, count) {
    return \`<div class="sec" role="presentation"><span class="sec-name">\${esc(name)}</span><span class="sec-n">· \${count}</span></div>\`;
  }

  // The Older Completed disclosure. The whole row is the button (UI-R09); the
  // chevron rotates to ⌄ when open (a separate state model from the ticket
  // chevrons — it controls only this section). \`aria-controls\` names the
  // expanded list only while it exists. One label — the count — with no
  // trailing tag: the ghost bar's own centering is the show-more affordance.
  function histToggle(expanded, n) {
    return \`<button type="button" class="k-btn k-btn--ghost hist" data-history="1" aria-expanded="\${expanded}"\${expanded ? ' aria-controls="histlist"' : ''}><span class="hist-chev">\${chev}</span><span>\${n} more completed</span></button>\`;
  }

  function emptyHtml(view) {
    if (state.filter) return '<div class="k-empty"><div class="k-empty-title">No tickets match</div></div>';
    if (view === 'archived') return '<div class="k-empty"><div class="k-empty-title">No archived tickets</div></div>';
    if (view === 'done') return '<div class="k-empty"><div class="k-empty-title">No done tickets</div></div>';
    return '<div class="k-empty"><div class="k-empty-title">No tickets yet</div>'
      + '<div class="k-empty-hint"><button type="button" class="k-btn k-btn--link" data-act="create">Create ticket</button></div></div>';
  }

  // The All view: Current (full treatment, canonical order) → Recently Done
  // (≤3, compact) → Older Completed behind the disclosure. Empty sections are
  // omitted entirely (a list with no Current tickets starts at Recently Done
  // rather than promoting history into primary weight), and the section
  // headers render only where their section does.
  function renderAll(L) {
    const cur = (state.sections && state.sections.current) || state.rows || [];
    const recent = (state.sections && state.sections.recentlyDone) || [];
    const older = (state.sections && state.sections.olderDone) || [];
    if (!cur.length && !recent.length && !older.length) {
      L.innerHTML = emptyHtml('');
      return;
    }
    const q = (state.filter || '').trim();
    // Auto-reveal: a query that matches Older Completed expands the section so
    // the match is visible, but that is NOT the user's explicit choice —
    // clearing the search restores the default collapsed state (histUser).
    const expanded = histUser ? histOpen : (q !== '' && older.length > 0);
    const html = [];
    if (cur.length) {
      html.push(secHtml('Current', cur.length));
      html.push(cur.map((r) => rowHtml(r, {})).join(''));
    }
    if (recent.length) {
      html.push(secHtml('Recently done', recent.length));
      html.push(recent.map((r) => rowHtml(r, { compact: true, time: true })).join(''));
    }
    if (older.length) {
      html.push(histToggle(expanded, older.length));
      if (expanded) {
        html.push(\`<div class="histlist" id="histlist">\${older.map((r) => rowHtml(r, { compact: true, older: true })).join('')}</div>\`);
      }
    }
    L.innerHTML = html.join('');
  }

  // The Done facet: the user explicitly asked for completed work, so no
  // hierarchy and no history control — every completed ticket at once,
  // newest first (Recently Done and Older Completed are conceptually merged).
  function renderDone(L) {
    const rows = state.done || [];
    if (!rows.length) { L.innerHTML = emptyHtml('done'); return; }
    L.innerHTML = secHtml('Done', rows.length)
      + rows.map((r) => rowHtml(r, { compact: true, time: true })).join('');
  }

  function renderList() {
    const L = el('list');
    const sel = new Set(state.facets || ['all']);
    if (sel.size === 1 && sel.has('all')) { renderAll(L); return; }
    if (sel.size === 1 && sel.has('done')) { renderDone(L); return; }
    // Archived facet + derived-status unions: the flat list, as before.
    const rows = state.rows || [];
    if (!rows.length) { L.innerHTML = emptyHtml(sel.has('archived') ? 'archived' : ''); return; }
    L.innerHTML = rows.map((r) => rowHtml(r, {})).join('');
  }

  // ---- interactions ----
  let searchTimer;
  el('search').addEventListener('input', (e) => {
    clearTimeout(searchTimer);
    const q = e.target.value;
    searchTimer = setTimeout(() => post({ type:'set-filter', query:q }), 150);
  });

  // Locate a row's data by id across every section/facet the list renders — the
  // shared context window's trigger only carries the ticketId, so the items
  // (which need nothing but the id) are rebuilt from that.
  function findRow(id) {
    for (const r of state.rows || []) if (r.ticketId === id) return r;
    for (const r of state.done || []) if (r.ticketId === id) return r;
    const secs = state.sections || {};
    for (const list of [secs.current, secs.recentlyDone, secs.olderDone]) {
      for (const r of list || []) if (r.ticketId === id) return r;
    }
    return null;
  }

  // Every posting control is delegated here — rows render by full innerHTML
  // replacement, so a per-element \`karstAction\` binding would go stale on the
  // next render. \`data-act\`/\`data-open\` controls use the runtime's pending
  // primitives directly (karstRequestId + karstBeginPending, the same pieces
  // \`karstAction\` uses internally) so they get the same four properties:
  // pending on click, non-re-triggerable, terminal result via \`action-result\`,
  // and the watchdog (UI-R11–R14). \`data-facet\`/\`data-toggle\` stay immediate —
  // their "settlement" is simply the next \`state\` push, not a tracked request.
  document.addEventListener('click', (e) => {
    const t = e.target.closest('[data-act],[data-open],[data-facet],[data-toggle],[data-history],[data-menu]');
    if (!t) return;
    if (t.dataset.menu) {
      // The ⋯ trigger toggles the shared ticket context window. Pure view
      // state, like the row's expand — settlement is the next render, never a
      // tracked request.
      e.stopPropagation();
      const id = Number(t.dataset.menu);
      const row = findRow(id);
      if (row && menuTicket === id) closeCtxMenu(true);
      else if (row) openCtxMenu(t, row);
      return;
    }
    if (t.dataset.act || t.dataset.open) {
      e.stopPropagation();
      // A context-window item click: the window closes (the action then posts).
      if (t.closest('#ctxMenu')) closeCtxMenu(false);
      if (karstIsPending(t) || t.disabled) { e.preventDefault(); return; }
      const type = t.dataset.act || 'open-ticket';
      const requestId = karstRequestId();
      karstBeginPending(t, requestId);
      const idRaw = t.dataset.act ? t.dataset.id : t.dataset.open;
      // resolve-conflicts carries the conflicted repo (the peek's first
      // conflicted repo) so the host re-verifies it against the store.
      const payload = { type, requestId };
      if (idRaw !== undefined) payload.ticketId = Number(idRaw);
      if (t.dataset.repo) payload.repo = t.dataset.repo;
      post(payload);
      return;
    }
    if (t.dataset.facet) {
      // Report only WHICH chip was clicked; the host owns the toggle/union logic.
      closeCtxMenu(false);
      post({ type:'toggle-facet', facet: t.dataset.facet });
      return;
    }
    if (t.dataset.history) {
      // Explicit click: this choice STICKS (survives searches and re-renders);
      // the automatic search reveal never sets this flag.
      closeCtxMenu(false);
      histUser = true;
      histOpen = !histOpen;
      renderList();
      return;
    }
    if (t.dataset.toggle) {
      e.stopPropagation();
      const id = Number(t.dataset.toggle);
      if (open.has(id)) open.delete(id); else open.add(id);
      closeCtxMenu(false);
      renderList();
    }
  });

  // The context window is a popup: an outside click closes it, and Escape
  // closes it returning focus to the trigger.
  document.addEventListener('click', (e) => {
    if (menuTicket === null) return;
    if (e.target.closest('#ctxMenu') || e.target.closest('[data-menu]')) return;
    closeCtxMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCtxMenu(true);
  });

  window.addEventListener('message', (e) => {
    const msg = e.data;
    if (!msg) return;
    if (msg.type === 'state') {
      state = msg.state;
      vscode.setState(state);
      // Prune expanded ids that no longer exist so the set can't grow
      // unbounded — across every section (current, recently/older done, the
      // done facet and the flat views).
      const ids = new Set((state.rows || []).map((r) => r.ticketId));
      for (const r of state.done || []) ids.add(r.ticketId);
      const secs = state.sections || {};
      for (const list of [secs.current, secs.recentlyDone, secs.olderDone]) {
        for (const r of list || []) ids.add(r.ticketId);
      }
      for (const id of [...open]) if (!ids.has(id)) open.delete(id);
      // The context window is anchored to a trigger inside the re-rendered rows,
      // so a state push always closes it (the popup's settled state is never a
      // ticket fact, and the anchor is gone the moment the list redraws).
      closeCtxMenu(false);
      // Keep the search box in sync only when the host changed the filter.
      if (el('search').value !== state.filter) el('search').value = state.filter;
      renderFacets();
      renderList();
    } else if (msg.type === 'action-result') {
      karstSettle(msg.requestId, msg.ok, msg.message);
    }
  });

  // Restore last snapshot immediately (view re-resolve), then ask for fresh.
  const prev = vscode.getState();
  if (prev) { state = prev; renderFacets(); renderList(); }
  post({ type:'request-state' });
</script>

