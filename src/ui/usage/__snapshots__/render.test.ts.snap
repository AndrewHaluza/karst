2.607c1.34 1.005 3.35.335 1.508-1.508C17.73 15.74 18.904 1 12.037 1 5.17 1 6.342 15.74.815 21.1c-2.01 2.009.167 2.511 1.507 1.506 5.192-3.517 4.857-9.714 9.715-9.714 4.857 0 4.522 6.197 9.714 9.715z\\"></path></svg>"},"opencode":{"label":"OpenCode","icon":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path d=\\"M16 6H8v12h8V6zm4 16H4V2h16v20z\\"></path></svg>"},"opencode2":{"label":"OpenCode v2","icon":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path d=\\"M16 6H8v12h8V6zm4 16H4V2h16v20z\\"></path></svg>"}};
const AGENT_PROVIDER_LABELS = {"claude":"Claude Code","codex":"Codex","antigravity":"Antigravity CLI","opencode":"OpenCode","opencode2":"OpenCode v2"};
const AGENT_ICONS = {"claude":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path clip-rule=\\"evenodd\\" d=\\"M20.998 10.949H24v3.102h-3v3.028h-1.487V20H18v-2.921h-1.487V20H15v-2.921H9V20H7.488v-2.921H6V20H4.487v-2.921H3V14.05H0V10.95h3V5h17.998v5.949zM6 10.949h1.488V8.102H6v2.847zm10.51 0H18V8.102h-1.49v2.847z\\"></path></svg>","codex":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path clip-rule=\\"evenodd\\" d=\\"M8.086.457a6.105 6.105 0 013.046-.415c1.333.153 2.521.72 3.564 1.7a.117.117 0 00.107.029c1.408-.346 2.762-.224 4.061.366l.063.03.154.076c1.357.703 2.33 1.77 2.918 3.198.278.679.418 1.388.421 2.126a5.655 5.655 0 01-.18 1.631.167.167 0 00.04.155 5.982 5.982 0 011.578 2.891c.385 1.901-.01 3.615-1.183 5.14l-.182.22a6.063 6.063 0 01-2.934 1.851.162.162 0 00-.108.102c-.255.736-.511 1.364-.987 1.992-1.199 1.582-2.962 2.462-4.948 2.451-1.583-.008-2.986-.587-4.21-1.736a.145.145 0 00-.14-.032c-.518.167-1.04.191-1.604.185a5.924 5.924 0 01-2.595-.622 6.058 6.058 0 01-2.146-1.781c-.203-.269-.404-.522-.551-.821a7.74 7.74 0 01-.495-1.283 6.11 6.11 0 01-.017-3.064.166.166 0 00.008-.074.115.115 0 00-.037-.064 5.958 5.958 0 01-1.38-2.202 5.196 5.196 0 01-.333-1.589 6.915 6.915 0 01.188-2.132c.45-1.484 1.309-2.648 2.577-3.493.282-.188.55-.334.802-.438.286-.12.573-.22.861-.304a.129.129 0 00.087-.087A6.016 6.016 0 015.635 2.31C6.315 1.464 7.132.846 8.086.457zm-.804 7.85a.848.848 0 00-1.473.842l1.694 2.965-1.688 2.848a.849.849 0 001.46.864l1.94-3.272a.849.849 0 00.007-.854l-1.94-3.393zm5.446 6.24a.849.849 0 000 1.695h4.848a.849.849 0 000-1.696h-4.848z\\"></path></svg>","antigravity":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path clip-rule=\\"evenodd\\" d=\\"M21.751 22.607c1.34 1.005 3.35.335 1.508-1.508C17.73 15.74 18.904 1 12.037 1 5.17 1 6.342 15.74.815 21.1c-2.01 2.009.167 2.511 1.507 1.506 5.192-3.517 4.857-9.714 9.715-9.714 4.857 0 4.522 6.197 9.714 9.715z\\"></path></svg>","opencode":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path d=\\"M16 6H8v12h8V6zm4 16H4V2h16v20z\\"></path></svg>","opencode2":"<svg fill=\\"currentColor\\" fill-rule=\\"evenodd\\" viewBox=\\"0 0 24 24\\" xmlns=\\"http://www.w3.org/2000/svg\\"><path d=\\"M16 6H8v12h8V6zm4 16H4V2h16v20z\\"></path></svg>"};
function agentMeta(p) {
  return Object.prototype.hasOwnProperty.call(AGENT_PROVIDERS, p) ? AGENT_PROVIDERS[p] : null;
}
function agentLabel(p) {
  const id = p || "";
  const meta = agentMeta(id);
  return meta ? meta.label : (id.charAt(0).toUpperCase() + id.slice(1));
}
function agentIconHtml(provider) {
  const meta = agentMeta(provider);
  const icon = meta ? meta.icon : "";
  return icon ? '<span class="agenticon" aria-hidden="true">' + icon + '</span>' : "";
}
function agentBadgeHtml(provider) {
  const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[c]));
  return '<span class="agentbadge">' + agentIconHtml(provider) + '<span class="agentname">' + esc(agentLabel(provider)) + '</span></span>';
}
function agentBadgeInto(el, provider) {
  if (el) el.innerHTML = agentBadgeHtml(provider);
}
function agentIconInto(el, provider) {
  if (el) el.innerHTML = agentIconHtml(provider);
}
function agentIdentityHtml(provider, model, compact) {
  const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[c]));
  const p = provider || "";
  const meta = agentMeta(p);
  const icon = meta && meta.icon
    ? '<span class="agent-identity-icon" aria-hidden="true">' + meta.icon + '</span>'
    : "";
  const name = '<span class="agent-identity-name">' + esc(agentLabel(p)) + '</span>';
  const modelHtml = model
    ? '<span class="agent-identity-sep" aria-hidden="true">·</span><span class="agent-identity-model" aria-label="' + esc(model) + '" title="' + esc(model) + '">' + esc(model) + '</span>'
    : "";
  return '<span class="agent-identity' + (compact ? ' compact' : '') + '"' + (p ? ' data-provider="' + esc(p) + '"' : '') + '>'
    + icon + name + modelHtml + '</span>';
}

  const vscode = acquireVsCodeApi();
  const post = (msg) => vscode.postMessage(msg);
  const el = (id) => document.getElementById(id);
  const esc = karstEsc;

  // Columns of the per-ticket table. \`sort\` is the key posted back when the
  // header is clicked; a column without one is not sortable. \`priority\` drives
  // the narrow tier (3 hides) and the tight tier (every row becomes a card).
  // The set matches USAGE_SORTS host-side — an unknown key is rejected there.
  const COLUMNS = [
    { key: 'ticket', label: 'Ticket', priority: 1 },
    { key: 'calls', label: 'Calls', sort: 'calls', num: true, priority: 2 },
    { key: 'input', label: 'Input', sort: 'input', num: true, priority: 3 },
    { key: 'output', label: 'Output', sort: 'output', num: true, priority: 3 },
    { key: 'total', label: 'Total', sort: 'total', num: true, priority: 1 },
    { key: 'last', label: 'Last call', sort: 'recent', num: true, priority: 2 },
  ];

  let lastState = null;
  // The last error string already surfaced through the toast, so a re-render
  // of an unchanged rejected query does not re-announce it (UI-R27).
  let lastErrorShown = null;
  // True only between a user action (sort/page/refresh) and the next state, so
  // an error on open stays inline and only an action's failure toasts (US-14).
  let userActionPending = false;

  const icon = (name) => (typeof karstIcon === 'function' ? karstIcon(name) : '');

  /** The focused control's identity, saved across a re-render (US-24). */
  const captureFocus = () => {
    const node = document.activeElement;
    if (!node || !node.dataset) return null;
    if (node.dataset.sort) return { kind: 'sort', value: node.dataset.sort };
    if (node.dataset.tab) return { kind: 'tab', value: node.dataset.tab };
    if (node.dataset.dir) return { kind: 'page', value: node.dataset.dir };
    return null;
  };

  /** Put focus back on the matching control; a disabled pager hands it over (US-24). */
  const restoreFocus = (saved) => {
    if (!saved) return;
    let target = null;
    if (saved.kind === 'sort') target = document.querySelector(\`[data-sort="\${saved.value}"]\`);
    else if (saved.kind === 'tab') target = document.querySelector(\`[data-tab="\${saved.value}"]\`);
    else if (saved.kind === 'page') target = document.querySelector(\`[data-dir="\${saved.value}"]\`);
    if (target && !target.disabled) { target.focus(); return; }
    if (saved.kind === 'page') {
      const other = document.querySelector(saved.value === 'prev' ? '[data-dir="next"]' : '[data-dir="prev"]');
      if (other && !other.disabled) other.focus();
    }
  };

  // The two tabs, built from state.tabs — never a hardcoded list. The active
  // tab posts \`set-tab\`; the host owns which tab is showing, like every other
  // selection in this view.
  const renderTabs = (state) => {
    const wrap = el('tabs');
    wrap.innerHTML = state.tabs.map((t) =>
      \`<button type="button" class="k-tab" id="tab-\${esc(t.id)}" role="tab" data-tab="\${esc(t.id)}"\` +
      \` aria-controls="\${esc(t.id)}" aria-selected="\${t.id === state.tab}"\` +
      \` tabindex="\${t.id === state.tab ? '0' : '-1'}">\${esc(t.label)}</button>\`,
    ).join('');
    for (const btn of wrap.querySelectorAll('[data-tab]')) {
      karstAction(btn, (requestId) => post({ type: 'set-tab', tab: btn.dataset.tab, requestId }), { tier: 'view' });
    }
  };

  // One row per core; one block per window. A core with no readable source
  // shows a plain reason, never a 0% bar. Every number/label arrives formatted.
  const renderQuota = (quota) => {
    const empty = quota.rows.length === 0;
    el('quotaEmpty').classList.toggle('hidden', !empty);
    el('qrows').classList.toggle('hidden', empty);
    const showSummary = quota.anyNear && !!quota.summaryLine;
    el('qsummary').classList.toggle('hidden', !showSummary);
    el('qsummary').innerHTML = showSummary
      ? icon('alert-triangle') + \`<span>\${esc(quota.summaryLine)}</span>\`
      : '';

    el('qrows').innerHTML = quota.rows.map((r) => {
      if (r.state === 'unknown') {
        return '<div class="qrow">' +
          \`<div class="qhead"><h3 class="qname">\${icon('info-circle')}<span>\${esc(r.label)}</span></h3>\` +
          '<span class="qstate">Quota not available</span></div>' +
          \`<div class="qreason" title="\${esc(r.reason || '')}">\${esc(r.plainReason || '')}</div>\` +
        '</div>';
      }
      const windows = r.windows.map((w) => {
        const badge = w.levelLabel
          ? \`<span class="qbadge lvl-\${esc(w.level)}">\` +
            \`\${w.level === 'exhausted' ? icon('circle-x') : icon('alert-triangle')}\` +
            \`<span>\${esc(w.levelLabel)}</span></span>\`
          : '';
        const pct = w.usedDisplay
          ? \`<span class="qpct lvl-\${esc(w.level)}">\${esc(w.usedDisplay)}</span>\`
          : '';
        // The level word and glyph sit before the percent, in one right-aligned end group (US-19).
        const end = badge || pct ? \`<span class="qend">\${badge}\${pct}</span>\` : '';
        return '<div class="qwin">' +
          \`<div class="qline"><span class="qlbl">\${esc(w.label)}</span>\${end}</div>\` +
          \`<div class="bar qbar lvl-\${esc(w.level)}" role="meter" aria-valuenow="\${w.expired ? 0 : w.usedPct}"\` +
            \` aria-valuemin="0" aria-valuemax="100" aria-label="\${esc(w.ariaLabel)}">\` +
            \`<i style="width:\${Number(w.width) || 0}%"></i></div>\` +
          \`<div class="qmeta">\${esc(w.meta)}</div>\` +
        '</div>';
      }).join('');
      const provenance = r.readMeta
        ? \` · <span class="\${r.stale ? 'stale' : ''}">\${r.stale ? icon('alert-triangle') : ''}\${esc(r.readMeta)}</span>\`
        : '';
      return '<div class="qrow">' +
        \`<div class="qhead"><h3 class="qname">\${agentIconHtml(r.core)}<span>\${esc(r.label)}</span></h3>\` +
          \`<span class="qmeta">\${esc(r.source || '')}\${provenance}</span></div>\` +
        windows +
      '</div>';
    }).join('');
  };

  const statCard = (label, value, note) =>
    \`<div class="stat"><div class="k">\${esc(label)}</div>\` +
    \`<div class="v">\${esc(value)}</div><div class="n">\${esc(note || '')}</div></div>\`;

  const renderStats = (state) => {
    const t = state.totals;
    const estimated = t.estimatedNote ? \`<span class="est">\${esc(t.estimatedNote)}</span>\` : '';
    el('stats').innerHTML = [
      // The headline is FRESH spend. Cache reads keep their own tile beside
      // it, never inside it: re-read context is charged at a fraction of the
      // fresh rate and dominates a long session's raw tally.
      \`<div class="stat stat--hero"><div class="k">Fresh tokens</div>\` +
        \`<div class="v">\${esc(t.totalDisplay)}</div>\` +
        \`<div class="n">\${esc(t.totalNote)}\${estimated}</div></div>\`,
      statCard('Input', t.inputDisplay, ''),
      statCard('Output', t.outputDisplay, ''),
      statCard('Reasoning', t.reasoningDisplay, ''),
      statCard('Cache write', t.cacheWriteDisplay, 'counted in fresh'),
      statCard('Cache read', t.cacheReadDisplay, 'not in fresh'),
      statCard('Calls', String(t.calls), t.erroredNote),
    ].join('');
    el('statsNotes').textContent = 'Fresh = input + output + reasoning + cache write · ' + state.costNote;
  };

  const renderBreakdown = (node, countEl, rows, countLabel, opts) => {
    const agentCore = !!(opts && opts.agentCore);
    countEl.textContent = String(rows.length);
    countEl.setAttribute('aria-label', countLabel);
    if (!rows.length) {
      node.innerHTML = '<div class="brow"><div class="meta">No tokens recorded yet</div></div>';
      return;
    }
    node.innerHTML = rows.map((r) => {
      // A known core prints its canonical mark beside the name (@ui:SG-25); an
      // unreported or folded row stays plain text.
      const labelHtml = agentCore && r.key !== '' && r.key !== '__other__'
        ? agentBadgeHtml(r.key)
        : esc(r.label);
      return '<div class="brow">' +
        '<div class="line">' +
          \`<span class="lbl" title="\${esc(r.title || r.label)}">\${labelHtml}</span>\` +
          \`<span class="amt" title="\${esc(r.totalExact)} tokens">\${esc(r.totalDisplay)}</span>\` +
          \`<span class="pct">\${esc(r.shareDisplay)}</span>\` +
        '</div>' +
        \`<div class="bar" aria-hidden="true"><i\${r.totalTokens > 0 ? ' class="bar-nz"' : ''} style="width:\${Number(r.share) || 0}%"></i></div>\` +
        \`<div class="meta">\${esc(r.callsText)} · in \${esc(r.inputDisplay)} · out \${esc(r.outputDisplay)}\` +
          (r.note ? \` · \${esc(r.note)}\` : '') +
          (r.estimated ? ' · <span class="est">estimated</span>' : '') +
        '</div>' +
      '</div>';
    }).join('');
  };

  const renderTable = (state) => {
    const thead = el('thead');
    thead.innerHTML = COLUMNS.map((c) => {
      const cls = c.num ? ' class="num"' : '';
      if (!c.sort) return \`<th\${cls} data-priority="\${c.priority}">\${esc(c.label)}</th>\`;
      const sorted = c.sort === state.sort;
      const ariaSort = sorted ? ' aria-sort="descending"' : '';
      // A real, keyboard-reachable control inside the header cell — not a
      // click handler on the <th> itself (UI-R09).
      return \`<th\${cls} data-priority="\${c.priority}"\${ariaSort}>\` +
        \`<button type="button" class="k-sort" data-sort="\${esc(c.sort)}"\` +
          \` aria-label="\${esc(c.label)}\${sorted ? ', sorted descending' : ''}">\` +
          \`\${esc(c.label)}\${sorted ? '<span aria-hidden="true">↓</span>' : ''}</button></th>\`;
    }).join('');
    for (const btn of thead.querySelectorAll('[data-sort]')) {
      karstAction(btn, (requestId) => {
        userActionPending = true;
        post({ type: 'set-sort', sort: btn.dataset.sort, requestId });
      }, { tier: 'view' });
    }

    const tbody = el('tbody');
    tbody.innerHTML = state.tickets.map((t) => {
      // A row with no ticket is spend recorded before the ticket existed; it has
      // no dashboard to open, so it is plain text rather than a dead button.
      let name;
      if (t.ticketId === null) {
        name = \`<span class="plain">\${esc(t.label)}</span>\`;
      } else {
        const title = t.ticketTitle
          ? \` <span class="tkt-sep" aria-hidden="true">—</span> <span class="tkt-title" aria-label="\${esc(t.ticketTitle)}">\${esc(t.ticketTitle)}</span>\`
          : '';
        name = \`<button type="button" class="k-btn k-btn--link" data-ticket="\${esc(t.ticketId)}"\` +
          \` title="\${esc(t.label)}"><span class="tkt-key">\${esc(t.ticketKey || '')}</span>\${title}</button>\`;
      }
      const last = t.lastAt
        ? \`<time datetime="\${esc(t.lastAt)}" title="\${esc(t.lastTitle)}">\${esc(t.lastDisplay)}</time>\`
        : esc(t.lastDisplay);
      return '<tr role="row">' +
        \`<td class="tkt" role="cell" data-priority="1" data-label="Ticket">\${name}</td>\` +
        \`<td class="num" role="cell" data-priority="2" data-label="Calls">\${esc(t.calls)}</td>\` +
        \`<td class="num" role="cell" data-priority="3" data-label="Input">\${esc(t.inputDisplay)}</td>\` +
        \`<td class="num" role="cell" data-priority="3" data-label="Output">\${esc(t.outputDisplay)}</td>\` +
        \`<td class="num" role="cell" data-priority="1" data-label="Total" title="\${esc(t.totalExact)} tokens">\` +
          \`\${esc(t.totalDisplay)}\${t.estimated ? ' <span class="est">≈</span>' : ''}</td>\` +
        \`<td class="num" role="cell" data-priority="2" data-label="Last call">\${last}</td>\` +
      '</tr>';
    }).join('');
    for (const btn of tbody.querySelectorAll('[data-ticket]')) {
      karstAction(btn, (requestId) => post({ type: 'open-dashboard', ticketId: Number(btn.dataset.ticket), requestId }), { tier: 'view' });
    }

    const p = state.page;
    const prevOffset = Math.max(0, p.offset - p.limit);
    const nextOffset = p.offset + p.limit;
    // Disabled means "unavailable" (page bounds), not "loading" — no
    // aria-busy on a statically disabled control, and a title says why
    // (UI-R17, UI-R19).
    const prevTitle = p.hasPrev ? 'Show the previous page of tickets' : 'No earlier page';
    const nextTitle = p.hasNext ? 'Show the next page of tickets' : 'No further page';
    const pager = el('pager');
    pager.innerHTML =
      \`<span>\${esc(p.summary)}</span><span class="spacer"></span>\` +
      \`<button type="button" class="k-btn k-btn--secondary k-btn--sm" data-dir="prev" data-page="\${esc(prevOffset)}" title="\${prevTitle}"\${p.hasPrev ? '' : ' disabled'}>Previous</button>\` +
      \`<button type="button" class="k-btn k-btn--secondary k-btn--sm" data-dir="next" data-page="\${esc(nextOffset)}" title="\${nextTitle}"\${p.hasNext ? '' : ' disabled'}>Next</button>\`;
    for (const btn of pager.querySelectorAll('[data-page]')) {
      karstAction(btn, (requestId) => {
        userActionPending = true;
        post({ type: 'set-page', offset: Number(btn.dataset.page), requestId });
      }, { tier: 'view' });
    }
  };

  const renderError = (state) => {
    const shown = !!state.error;
    el('err').classList.toggle('hidden', !shown);
    el('errText').textContent = state.error || '';
    if (shown && state.error !== lastErrorShown) {
      // A rejected query is announced through the one shared live region
      // (the toast) only when it follows a user action; an error on open stays
      // inline (UI-R27, US-14).
      if (userActionPending) karstToast('error', state.error);
      lastErrorShown = state.error;
    } else if (!shown) {
      lastErrorShown = null;
    }
    userActionPending = false;
  };

  const renderSpend = (state) => {
    // An error is not an empty state: showing the empty state under a rejected
    // query would claim nothing was spent when nothing was asked.
    const showEmpty = state.empty && !state.error;
    el('empty').classList.toggle('hidden', !showEmpty);
    el('body').classList.toggle('hidden', state.empty || !!state.error);
    if (state.empty || state.error) return;

    renderStats(state);
    renderBreakdown(el('providers'), el('providerCount'), state.byProvider, state.counts.providers, { agentCore: true });
    renderBreakdown(el('activities'), el('activityCount'), state.byActivity, state.counts.activities);
    renderBreakdown(el('models'), el('modelCount'), state.byModel, state.counts.models);
    renderBreakdown(el('profiles'), el('profileCount'), state.byProfile, state.counts.profiles);
    el('tktCount').textContent = String(state.page.groups);
    el('tktCount').setAttribute('aria-label', state.counts.tickets);
    renderTable(state);
  };

  const render = (state) => {
    if (!state) return;
    const savedFocus = captureFocus();
    lastState = state;

    el('loading').classList.add('hidden');
    renderTabs(state);

    const quotaTab = state.tab === 'quota';
    el('spend').classList.toggle('hidden', quotaTab);
    el('quota').classList.toggle('hidden', !quotaTab);

    el('sub').textContent = quotaTab ? state.quota.subtitle : state.scopeLabel;
    el('updated').textContent = state.updatedLabel;
    el('status').textContent = state.updatedLabel || 'Loading token usage';

    renderError(state);
    if (quotaTab) renderQuota(state.quota);
    else renderSpend(state);

    restoreFocus(savedFocus);
  };

  // Roving tablist keys (US-21): arrows move between tabs, Home/End to the ends.
  el('tabs').addEventListener('keydown', (e) => {
    const keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End'];
    if (!keys.includes(e.key)) return;
    const tabs = Array.from(el('tabs').querySelectorAll('[data-tab]'));
    const at = tabs.findIndex((t) => t === document.activeElement);
    if (at < 0) return;
    let next;
    if (e.key === 'Home') next = 0;
    else if (e.key === 'End') next = tabs.length - 1;
    else next = (at + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
    e.preventDefault();
    tabs[next].focus();
    tabs[next].click();
  });

  // Header and empty-state controls are static, so they bind once.
  el('errIcon').innerHTML = icon('circle-x');
  karstAction(el('refreshBtn'), (requestId) => {
    userActionPending = true;
    post({ type: 'request-state', requestId });
  }, { tier: 'view' });
  karstAction(el('retryBtn'), (requestId) => {
    userActionPending = true;
    post({ type: 'request-state', requestId });
  }, { tier: 'view' });
  karstAction(el('createTicketBtn'), (requestId) => post({ type: 'create-ticket', requestId }), { tier: 'mutation' });
  karstAction(el('refreshQuotaBtn'), (requestId) => post({ type: 'refresh-quota', requestId }), { tier: 'mutation' });
  karstAction(el('quotaSettingsBtn'), (requestId) => post({ type: 'open-quota-settings', requestId }), { tier: 'mutation' });

  window.addEventListener('message', (e) => {
    const msg = e.data;
    if (!msg) return;
    if (msg.type === 'state') {
      render(msg.state);
      // Reload carrier for the selected tab; the host stays the owner and reads it back on restore.
      try {
        vscode.setState({ tab: msg.state.tab });
      } catch {
        /* state persistence is best-effort */
      }
    }
    else if (msg.type === 'action-result') karstSettle(msg.requestId, msg.ok, msg.message);
  });

  // The host pushes on open, but a webview that was restored (or reloaded)
  // missed it — ask, rather than render a blank page.
  post({ type: 'request-state' });
</script>
"
`;

