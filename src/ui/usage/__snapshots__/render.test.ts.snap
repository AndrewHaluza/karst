    const thead = el('thead');
    thead.innerHTML = COLUMNS.map((c) => {
      const cls = c.num ? ' class="num"' : '';
      if (!c.sort) return \`<th\${cls}>\${esc(c.label)}</th>\`;
      const sorted = c.sort === state.sort ? ' aria-sort="descending"' : '';
