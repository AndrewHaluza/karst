  const COLUMNS = [
    { key: 'ticket', label: 'Ticket' },
    { key: 'calls', label: 'Calls', sort: 'calls', num: true },
    { key: 'input', label: 'Input', sort: 'input', num: true },
    { key: 'output', label: 'Output', sort: 'output', num: true },
    { key: 'total', label: 'Total', sort: 'total', num: true },
    { key: 'last', label: 'Last call', sort: 'recent', num: true },
