// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`usage render > all-sorts > snapshot 1`] = `
"<div class="usage-page">
  <header class="k-pagehead">
    <div class="k-pagehead-main">
      <div>
        <h1 class="k-pagehead-title">Token usage</h1>
        <p class="k-pagehead-sub" id="sub">All time · since Feb 14, 2026</p>
      </div>
    </div>
    <div class="k-pagehead-actions">
      <span class="updated" id="updated">Updated 10:42</span>
      <button type="button" class="k-btn k-btn--secondary k-btn--sm" id="refreshBtn">Refresh</button>
    </div>
  </header>

  <div class="k-tabs" role="tablist" aria-label="Token usage views" id="tabs"><button type="button" class="k-tab" id="tab-spend" role="tab" data-tab="spend" aria-controls="spend" aria-selected="true" tabindex="0">Spend</button><button type="button" class="k-tab" id="tab-quota" role="tab" data-tab="quota" aria-controls="quota" aria-selected="false" tabindex="-1">Quota</button></div>

  <main id="main">
    <div class="sr-only" role="status" aria-live="polite" id="status">Updated 10:42</div>

    <div class="err hidden" id="err">
      <span class="err-icon" id="errIcon" aria-hidden="true"><svg class="k-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M10 10l4 4m0 -4l-4 4"></path></svg></span>
      <span class="err-text" id="errText"></span>
      <button type="button" class="k-btn k-btn--secondary k-btn--sm" id="retryBtn">Try again</button>
    </div>

    <div id="loading" class="hidden">
      <div class="stats sk-gap">
        <div class="sk sk-stat"></div>
        <div class="sk sk-stat"></div>
        <div class="sk sk-stat"></div>
        <div class="sk sk-stat"></div>
        <div class="sk sk-stat"></div>
      </div>
      <div class="grid sk-gap">
        <div class="sk sk-panel"></div>
        <div class="sk sk-panel"></div>
        <div class="sk sk-panel"></div>
      </div>
    </div>

    <div id="spend" role="tabpanel" aria-labelledby="tab-spend">
      <div id="body" class="">
        <div class="stats" id="stats"><div class="stat stat--hero"><div class="k">Fresh tokens</div><div class="v">1M</div><div class="n">1,000,000 tokens<span class="est">2 of 42 calls estimated</span></div></div><div class="stat"><div class="k">Input</div><div class="v">390.1k</div><div class="n"></div></div><div class="stat"><div class="k">Output</div><div class="v">459.9k</div><div class="n"></div></div><div class="stat"><div class="k">Reasoning</div><div class="v">100k</div><div class="n"></div></div><div class="stat"><div class="k">Cache write</div><div class="v">50k</div><div class="n">counted in fresh</div></div><div class="stat"><div class="k">Cache read</div><div class="v">3.4M</div><div class="n">not in fresh</div></div><div class="stat"><div class="k">Calls</div><div class="v">42</div><div class="n">1 failed</div></div></div>
        <div class="stats-notes" id="statsNotes">Fresh = input + output + reasoning + cache write · Tokens, not cost</div>
        <div class="grid">
          <section class="panel">
            <h2 class="phead">By agent core<span class="count" id="providerCount" aria-label="3 agent cores">3</span></h2>
