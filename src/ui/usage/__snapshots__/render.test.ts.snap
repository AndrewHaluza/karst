  let lastState = null;
  // The last error string already surfaced through the toast, so a re-render
  // of an unchanged rejected query does not re-announce it (UI-R27).
  let lastErrorShown = null;

  /** An ISO stamp as the viewer's local date. The host sends the instant. */
  const localDate = (iso) => {
    if (!iso) return '';
    const d = new Date(iso);
    return isNaN(d.getTime()) ? '' : d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  };

  // Range presets — a real selectable chip (UI-R08, UI-R09), not a bespoke
  // bordered-button toggle: the same primitive \`sidebar\`'s facet pills use.
  const renderRanges = (state) => {
    const wrap = el('ranges');
    wrap.innerHTML = state.ranges.map((r) =>
      \`<button type="button" class="k-chip" data-range="\${esc(r.id)}" aria-pressed="\${r.id === state.rangeId}">\${esc(r.label)}</button>\`,
    ).join('');
    for (const btn of wrap.querySelectorAll('[data-range]')) {
      karstAction(btn, (requestId) => post({ type: 'set-range', range: btn.dataset.range, requestId }));
    }
  };

  const statCard = (label, value, note, flag) =>
    \`<div class="stat\${flag ? ' flag' : ''}"><div class="k">\${esc(label)}</div>\` +
    \`<div class="v">\${esc(value)}</div><div class="n">\${esc(note || '')}</div></div>\`;

  const renderStats = (t) => {
    el('stats').innerHTML = [
      // The headline is FRESH spend. Cache reads keep their own tile beside
      // it, never inside it: re-read context is charged at a fraction of the
      // fresh rate and dominates a long session's raw tally.
      statCard('Fresh tokens', t.totalDisplay, t.totalExact),
      statCard('Input', t.inputDisplay, ''),
      statCard('Output', t.outputDisplay, ''),
      statCard('Reasoning', t.reasoningDisplay, ''),
      statCard('Cache read', t.cacheReadDisplay, 'billed apart from fresh'),
      statCard('Calls', String(t.calls), t.erroredCalls ? \`\${t.erroredCalls} failed\` : ''),
      // Estimated calls get their own tile rather than a footnote: whether the
      // headline number was measured or approximated changes how it may be used.
      statCard('Estimated', String(t.estimatedCalls), t.estimatedCalls ? 'counts approximated' : 'all measured', t.estimatedCalls > 0),
    ].join('');
  };

  const renderBreakdown = (node, rows) => {
    if (!rows.length) { node.innerHTML = '<div class="brow"><div class="meta">nothing in this range</div></div>'; return; }
    node.innerHTML = rows.map((r) =>
      '<div class="brow">' +
        '<div class="line">' +
          \`<span class="lbl" title="\${esc(r.label)}">\${esc(r.label)}</span>\` +
          \`<span class="amt" title="\${esc(r.totalExact)} tokens">\${esc(r.totalDisplay)}</span>\` +
          \`<span class="pct">\${esc(r.share)}%</span>\` +
        '</div>' +
        \`<div class="bar"><i style="width:\${Number(r.share) || 0}%"></i></div>\` +
        \`<div class="meta">\${esc(r.calls)} call\${r.calls === 1 ? '' : 's'} · in \${esc(r.inputDisplay)} · out \${esc(r.outputDisplay)}\` +
          (r.note ? \` · \${esc(r.note)}\` : '') +
          (r.estimated ? ' · <span class="est">estimated</span>' : '') +
        '</div>' +
      '</div>',
    ).join('');
  };

  const renderTable = (state) => {
    const thead = el('thead');
    thead.innerHTML = COLUMNS.map((c) => {
      const cls = c.num ? ' class="num"' : '';
      if (!c.sort) return \`<th\${cls}>\${esc(c.label)}</th>\`;
      const sorted = c.sort === state.sort ? ' aria-sort="descending"' : '';
      // A real, keyboard-reachable control inside the header cell — not a
      // click handler on the <th> itself (UI-R09).
      return \`<th\${cls}\${sorted}><button type="button" class="k-btn k-btn--link" data-sort="\${esc(c.sort)}">\${esc(c.label)}</button></th>\`;
    }).join('');
    for (const btn of thead.querySelectorAll('[data-sort]')) {
      karstAction(btn, (requestId) => post({ type: 'set-sort', sort: btn.dataset.sort, requestId }));
    }

    const tbody = el('tbody');
    tbody.innerHTML = state.tickets.map((t) => {
      // A row with no ticket is spend recorded before the ticket existed; it has
      // no dashboard to open, so it is plain text rather than a dead button.
      const name = t.ticketId === null
        ? \`<span class="plain">\${esc(t.label)}</span>\`
        : \`<button type="button" class="k-btn k-btn--link" data-ticket="\${esc(t.ticketId)}" title="\${esc(t.label)}" aria-label="\${esc(t.label)}">\${esc(t.label)}</button>\`;
      return '<tr>' +
        \`<td class="tkt">\${name}</td>\` +
        \`<td class="num">\${esc(t.calls)}</td>\` +
        \`<td class="num">\${esc(t.inputDisplay)}</td>\` +
        \`<td class="num">\${esc(t.outputDisplay)}</td>\` +
        \`<td class="num" title="\${esc(t.totalExact)} tokens">\${esc(t.totalDisplay)}\${t.estimated ? ' <span class="est">≈</span>' : ''}</td>\` +
        \`<td class="num">\${esc(localDate(t.lastAt))}</td>\` +
      '</tr>';
    }).join('');
    for (const btn of tbody.querySelectorAll('[data-ticket]')) {
      karstAction(btn, (requestId) => post({ type: 'open-dashboard', ticketId: Number(btn.dataset.ticket), requestId }));
    }

    const p = state.page;
    const first = p.groups === 0 ? 0 : p.offset + 1;
    const last = p.offset + state.tickets.length;
    const prevOffset = Math.max(0, p.offset - p.limit);
    const nextOffset = p.offset + p.limit;
    // Disabled means "unavailable" (page bounds), not "loading" — no
    // aria-busy on a statically disabled control, and a title says why
    // (UI-R17, UI-R19).
    const prevTitle = p.hasPrev ? 'Show the previous page of tickets' : 'No earlier page';
    const nextTitle = p.hasNext ? 'Show the next page of tickets' : 'No further page';
    const pager = el('pager');
    pager.innerHTML =
      \`<span>\${first}–\${last} of \${p.groups}</span><span class="spacer"></span>\` +
      \`<button type="button" class="k-btn k-btn--secondary k-btn--sm" data-page="\${prevOffset}" title="\${prevTitle}"\${p.hasPrev ? '' : ' disabled'}>Previous</button>\` +
      \`<button type="button" class="k-btn k-btn--secondary k-btn--sm" data-page="\${nextOffset}" title="\${nextTitle}"\${p.hasNext ? '' : ' disabled'}>Next</button>\`;
    for (const btn of pager.querySelectorAll('[data-page]')) {
      karstAction(btn, (requestId) => post({ type: 'set-page', offset: Number(btn.dataset.page), requestId }));
    }
  };

  const render = (state) => {
    if (!state) return;
    lastState = state;
    renderRanges(state);

    el('err').textContent = state.error || '';
    el('err').classList.toggle('hidden', !state.error);
    // A rejected query is announced through the one shared live region
    // (the toast) rather than a second live region on #err (UI-R27), and only
    // once per distinct error so an unrelated re-render does not re-announce it.
    if (state.error) {
      if (state.error !== lastErrorShown) karstToast('error', state.error);
      lastErrorShown = state.error;
    } else {
      lastErrorShown = null;
    }

    const rangeLabel = (state.ranges.find((r) => r.id === state.rangeId) || {}).label || '';
    el('sub').textContent = rangeLabel;

    // An error is not an empty range: showing the empty state under a rejected
    // query would claim nothing was spent when nothing was asked.
    const showEmpty = state.empty && !state.error;
    el('empty').classList.toggle('hidden', !showEmpty);
    el('emptyHint').textContent = \`Nothing was recorded for \${rangeLabel.toLowerCase()}. Try a wider range, or run an AI-backed action (ticket analysis, PR description).\`;
    el('body').classList.toggle('hidden', state.empty || !!state.error);
    if (state.empty || state.error) return;

    renderStats(state.totals);
    el('stageCount').textContent = state.byStage.length;
    el('modelCount').textContent = state.byModel.length;
    el('profileCount').textContent = state.byProfile.length;
    el('tktCount').textContent = state.page.groups;
    renderBreakdown(el('stages'), state.byStage);
    renderBreakdown(el('models'), state.byModel);
    renderBreakdown(el('profiles'), state.byProfile);
    renderTable(state);
  };

  window.addEventListener('message', (e) => {
    const msg = e.data;
    if (!msg) return;
    if (msg.type === 'state') render(msg.state);
    else if (msg.type === 'action-result') karstSettle(msg.requestId, msg.ok, msg.message);
  });

  // The host pushes on open, but a webview that was restored (or reloaded)
  // missed it — ask, rather than render a blank page.
  post({ type: 'request-state' });
</script>
"
`;
