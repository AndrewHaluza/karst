var KARST_TABLER_ICONS = {"archive":"<path d=\\"M3 6a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2\\"/><path d=\\"M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-10\\"/><path d=\\"M10 12l4 0\\"/>","chart-bar":"<path d=\\"M3 13a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -6\\"/><path d=\\"M15 9a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -10\\"/><path d=\\"M9 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -14\\"/><path d=\\"M4 20h14\\"/>","check":"<path d=\\"M5 12l5 5l10 -10\\"/>","chevron-down":"<path d=\\"M6 9l6 6l6 -6\\"/>","chevron-right":"<path d=\\"M9 6l6 6l-6 6\\"/>","circle-check":"<path d=\\"M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\\"/><path d=\\"M9 12l2 2l4 -4\\"/>","circle-x":"<path d=\\"M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\\"/><path d=\\"M10 10l4 4m0 -4l-4 4\\"/>","copy":"<path d=\\"M7 9.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666\\"/><path d=\\"M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1\\"/>","corner-down-right":"<path d=\\"M6 6v6a3 3 0 0 0 3 3h10l-4 -4m0 8l4 -4\\"/>","dashboard":"<path d=\\"M10 13a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M13.45 11.55l2.05 -2.05\\"/><path d=\\"M6.4 20a9 9 0 1 1 11.2 0l-11.2 0\\"/>","dots":"<path d=\\"M5 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\\"/><path d=\\"M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\\"/><path d=\\"M19 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\\"/>","external-link":"<path d=\\"M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6\\"/><path d=\\"M11 13l9 -9\\"/><path d=\\"M15 4h5v5\\"/>","file-text":"<path d=\\"M14 3v4a1 1 0 0 0 1 1h4\\"/><path d=\\"M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2\\"/><path d=\\"M9 9l1 0\\"/><path d=\\"M9 13l6 0\\"/><path d=\\"M9 17l6 0\\"/>","folder":"<path d=\\"M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2\\"/>","git-compare":"<path d=\\"M4 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M16 18a2 2 0 1 0 4 0a2 2 0 1 0 -4 0\\"/><path d=\\"M11 6h5a2 2 0 0 1 2 2v8\\"/><path d=\\"M14 9l-3 -3l3 -3\\"/><path d=\\"M13 18h-5a2 2 0 0 1 -2 -2v-8\\"/><path d=\\"M10 15l3 3l-3 3\\"/>","history":"<path d=\\"M12 8l0 4l2 2\\"/><path d=\\"M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5\\"/>","layout-dashboard":"<path d=\\"M5 4h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1\\"/><path d=\\"M5 16h4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1\\"/><path d=\\"M15 12h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-6a1 1 0 0 1 1 -1\\"/><path d=\\"M15 4h4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1\\"/>","pencil":"<path d=\\"M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4\\"/><path d=\\"M13.5 6.5l4 4\\"/>","bug":"<path d=\\"M9 9v-1a3 3 0 0 1 6 0v1\\"/><path d=\\"M8 9h8a6 6 0 0 1 1 3v3a5 5 0 0 1 -10 0v-3a6 6 0 0 1 1 -3\\"/><path d=\\"M3 13l4 0\\"/><path d=\\"M17 13l4 0\\"/><path d=\\"M12 20l0 -6\\"/><path d=\\"M4 19l3.35 -2\\"/><path d=\\"M20 19l-3.35 -2\\"/><path d=\\"M4 7l3.75 2.4\\"/><path d=\\"M20 7l-3.75 2.4\\"/>","play-bug":"<path d=\\"M3.5 18a2.5 3 0 1 0 5 0a2.5 3 0 1 0 -5 0\\"/><path d=\\"M2 18h1.5\\"/><path d=\\"M8.5 18h1.5\\"/><path d=\\"M9.5 14.5l-1.5 1.5\\"/><path d=\\"M2.5 14.5l1.5 1.5\\"/><path d=\\"M2.5 21.5l1.5 -1.5\\"/><path d=\\"M8 20l1.5 1.5\\"/><path d=\\"M13 16l8 -5l-13 -8v8\\"/>","player-pause":"<path d=\\"M6 5m0 1a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v12a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1z\\"/><path d=\\"M14 5m0 1a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v12a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1z\\"/>","player-play":"<path d=\\"M7 4v16l13 -8l-13 -8\\"/>","player-stop":"<path d=\\"M5 7a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2l0 -10\\"/>","plus":"<path d=\\"M12 5l0 14\\"/><path d=\\"M5 12l14 0\\"/>","refresh":"<path d=\\"M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4\\"/><path d=\\"M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4\\"/>","search":"<path d=\\"M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\\"/><path d=\\"M21 21l-6 -6\\"/>","server-2":"<path d=\\"M3 7a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-2\\"/><path d=\\"M3 15a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3l0 -2\\"/><path d=\\"M7 8l0 .01\\"/><path d=\\"M7 16l0 .01\\"/><path d=\\"M11 8h6\\"/><path d=\\"M11 16h6\\"/>","settings":"<path d=\\"M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065\\"/><path d=\\"M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\\"/>","terminal-2":"<path d=\\"M8 9l3 3l-3 3\\"/><path d=\\"M13 15l3 0\\"/><path d=\\"M3 6a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -12\\"/>","trash":"<path d=\\"M4 7l16 0\\"/><path d=\\"M10 11l0 6\\"/><path d=\\"M14 11l0 6\\"/><path d=\\"M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12\\"/><path d=\\"M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3\\"/>"};

/**
 * Full inline svg for a catalog glyph. size is CSS px (default 16); cls is an
 * optional extra class beside .k-icon. Unknown name → '' — never a throw.
 */
function karstIcon(name, size, cls) {
  var paths = KARST_TABLER_ICONS[name];
  if (!paths) return '';
  size = size || 16;
  var k = 'k-icon' + (cls ? ' ' + cls : '');
  return '<svg class="' + k + '" width="' + size + '" height="' + size
    + '" viewBox="0 0 24 24" aria-hidden="true" focusable="false">'
    + paths + '</svg>';
}

  const vscode = acquireVsCodeApi();
  const post = (msg) => vscode.postMessage(msg);
  const el = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));

  // Columns of the per-ticket table. \`sort\` is the key posted back when the
  // header is clicked; a column without one is not sortable. The set matches
  // USAGE_SORTS host-side — an unknown key is rejected there, never applied.
  const COLUMNS = [
    { key: 'ticket', label: 'Ticket' },
    { key: 'calls', label: 'Calls', sort: 'calls', num: true },
    { key: 'input', label: 'Input', sort: 'input', num: true },
    { key: 'output', label: 'Output', sort: 'output', num: true },
    { key: 'total', label: 'Total', sort: 'total', num: true },
    { key: 'last', label: 'Last call', sort: 'recent', num: true },
  ];

  let lastState = null;
  // The last error string already surfaced through the toast, so a re-render
  // of an unchanged rejected query does not re-announce it (UI-R27).
  let lastErrorShown = null;

  /** An ISO stamp as the viewer's local date. The host sends the instant. */
  const localDate = (iso) => {
    if (!iso) return '';
    const d = new Date(iso);
    return isNaN(d.getTime()) ? '' : d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  };

  // Range presets — a real selectable chip (UI-R08, UI-R09), not a bespoke
  // bordered-button toggle: the same primitive \`sidebar\`'s facet pills use.
  const renderRanges = (state) => {
    const wrap = el('ranges');
    wrap.innerHTML = state.ranges.map((r) =>
      \`<button type="button" class="k-chip" data-range="\${esc(r.id)}" aria-pressed="\${r.id === state.rangeId}">\${esc(r.label)}</button>\`,
    ).join('');
    for (const btn of wrap.querySelectorAll('[data-range]')) {
      karstAction(btn, (requestId) => post({ type: 'set-range', range: btn.dataset.range, requestId }));
    }
  };

  const statCard = (label, value, note, flag) =>
    \`<div class="stat\${flag ? ' flag' : ''}"><div class="k">\${esc(label)}</div>\` +
    \`<div class="v">\${esc(value)}</div><div class="n">\${esc(note || '')}</div></div>\`;

  const renderStats = (t) => {
    el('stats').innerHTML = [
      // The headline is FRESH spend. Cache reads keep their own tile beside
      // it, never inside it: re-read context is charged at a fraction of the
      // fresh rate and dominates a long session's raw tally.
      statCard('Fresh tokens', t.totalDisplay, t.totalExact),
      statCard('Input', t.inputDisplay, ''),
      statCard('Output', t.outputDisplay, ''),
      statCard('Reasoning', t.reasoningDisplay, ''),
      statCard('Cache read', t.cacheReadDisplay, 'billed apart from fresh'),
      statCard('Calls', String(t.calls), t.erroredCalls ? \`\${t.erroredCalls} failed\` : ''),
      // Estimated calls get their own tile rather than a footnote: whether the
      // headline number was measured or approximated changes how it may be used.
      statCard('Estimated', String(t.estimatedCalls), t.estimatedCalls ? 'counts approximated' : 'all measured', t.estimatedCalls > 0),
    ].join('');
  };

  const renderBreakdown = (node, rows) => {
    if (!rows.length) { node.innerHTML = '<div class="brow"><div class="meta">nothing in this range</div></div>'; return; }
    node.innerHTML = rows.map((r) =>
      '<div class="brow">' +
        '<div class="line">' +
          \`<span class="lbl" title="\${esc(r.label)}">\${esc(r.label)}</span>\` +
          \`<span class="amt" title="\${esc(r.totalExact)} tokens">\${esc(r.totalDisplay)}</span>\` +
          \`<span class="pct">\${esc(r.share)}%</span>\` +
        '</div>' +
        \`<div class="bar"><i style="width:\${Number(r.share) || 0}%"></i></div>\` +
        \`<div class="meta">\${esc(r.calls)} call\${r.calls === 1 ? '' : 's'} · in \${esc(r.inputDisplay)} · out \${esc(r.outputDisplay)}\` +
          (r.note ? \` · \${esc(r.note)}\` : '') +
          (r.estimated ? ' · <span class="est">estimated</span>' : '') +
        '</div>' +
      '</div>',
    ).join('');
  };

  const renderTable = (state) => {
    const thead = el('thead');
    thead.innerHTML = COLUMNS.map((c) => {
      const cls = c.num ? ' class="num"' : '';
      if (!c.sort) return \`<th\${cls}>\${esc(c.label)}</th>\`;
      const sorted = c.sort === state.sort ? ' aria-sort="descending"' : '';
      // A real, keyboard-reachable control inside the header cell — not a
      // click handler on the <th> itself (UI-R09).
      return \`<th\${cls}\${sorted}><button type="button" class="k-btn k-btn--link" data-sort="\${esc(c.sort)}">\${esc(c.label)}</button></th>\`;
    }).join('');
    for (const btn of thead.querySelectorAll('[data-sort]')) {
      karstAction(btn, (requestId) => post({ type: 'set-sort', sort: btn.dataset.sort, requestId }));
    }

    const tbody = el('tbody');
    tbody.innerHTML = state.tickets.map((t) => {
      // A row with no ticket is spend recorded before the ticket existed; it has
      // no dashboard to open, so it is plain text rather than a dead button.
      const name = t.ticketId === null
        ? \`<span class="plain">\${esc(t.label)}</span>\`
        : \`<button type="button" class="k-btn k-btn--link" data-ticket="\${esc(t.ticketId)}" title="\${esc(t.label)}" aria-label="\${esc(t.label)}">\${esc(t.label)}</button>\`;
      return '<tr>' +
        \`<td class="tkt">\${name}</td>\` +
        \`<td class="num">\${esc(t.calls)}</td>\` +
        \`<td class="num">\${esc(t.inputDisplay)}</td>\` +
        \`<td class="num">\${esc(t.outputDisplay)}</td>\` +
        \`<td class="num" title="\${esc(t.totalExact)} tokens">\${esc(t.totalDisplay)}\${t.estimated ? ' <span class="est">≈</span>' : ''}</td>\` +
        \`<td class="num">\${esc(localDate(t.lastAt))}</td>\` +
      '</tr>';
    }).join('');
    for (const btn of tbody.querySelectorAll('[data-ticket]')) {
      karstAction(btn, (requestId) => post({ type: 'open-dashboard', ticketId: Number(btn.dataset.ticket), requestId }));
    }

    const p = state.page;
    const first = p.groups === 0 ? 0 : p.offset + 1;
    const last = p.offset + state.tickets.length;
    const prevOffset = Math.max(0, p.offset - p.limit);
    const nextOffset = p.offset + p.limit;
    // Disabled means "unavailable" (page bounds), not "loading" — no
    // aria-busy on a statically disabled control, and a title says why
    // (UI-R17, UI-R19).
    const prevTitle = p.hasPrev ? 'Show the previous page of tickets' : 'No earlier page';
    const nextTitle = p.hasNext ? 'Show the next page of tickets' : 'No further page';
    const pager = el('pager');
    pager.innerHTML =
      \`<span>\${first}–\${last} of \${p.groups}</span><span class="spacer"></span>\` +
      \`<button type="button" class="k-btn k-btn--secondary k-btn--sm" data-page="\${prevOffset}" title="\${prevTitle}"\${p.hasPrev ? '' : ' disabled'}>Previous</button>\` +
      \`<button type="button" class="k-btn k-btn--secondary k-btn--sm" data-page="\${nextOffset}" title="\${nextTitle}"\${p.hasNext ? '' : ' disabled'}>Next</button>\`;
    for (const btn of pager.querySelectorAll('[data-page]')) {
      karstAction(btn, (requestId) => post({ type: 'set-page', offset: Number(btn.dataset.page), requestId }));
    }
  };

  const render = (state) => {
    if (!state) return;
    lastState = state;
    renderRanges(state);

    el('err').textContent = state.error || '';
    el('err').classList.toggle('hidden', !state.error);
    // A rejected query is announced through the one shared live region
    // (the toast) rather than a second live region on #err (UI-R27), and only
    // once per distinct error so an unrelated re-render does not re-announce it.
    if (state.error) {
      if (state.error !== lastErrorShown) karstToast('error', state.error);
      lastErrorShown = state.error;
    } else {
      lastErrorShown = null;
    }

    const rangeLabel = (state.ranges.find((r) => r.id === state.rangeId) || {}).label || '';
    el('sub').textContent = rangeLabel;

    // An error is not an empty range: showing the empty state under a rejected
    // query would claim nothing was spent when nothing was asked.
    const showEmpty = state.empty && !state.error;
    el('empty').classList.toggle('hidden', !showEmpty);
    el('emptyHint').textContent = \`Nothing was recorded for \${rangeLabel.toLowerCase()}. Try a wider range, or run an AI-backed action (ticket analysis, PR description).\`;
    el('body').classList.toggle('hidden', state.empty || !!state.error);
    if (state.empty || state.error) return;

    renderStats(state.totals);
    el('stageCount').textContent = state.byStage.length;
    el('modelCount').textContent = state.byModel.length;
    el('profileCount').textContent = state.byProfile.length;
    el('tktCount').textContent = state.page.groups;
    renderBreakdown(el('stages'), state.byStage);
    renderBreakdown(el('models'), state.byModel);
    renderBreakdown(el('profiles'), state.byProfile);
    renderTable(state);
  };

  window.addEventListener('message', (e) => {
    const msg = e.data;
    if (!msg) return;
    if (msg.type === 'state') render(msg.state);
    else if (msg.type === 'action-result') karstSettle(msg.requestId, msg.ok, msg.message);
  });

  // The host pushes on open, but a webview that was restored (or reloaded)
  // missed it — ask, rather than render a blank page.
  post({ type: 'request-state' });
</script>
"
`;

exports[`usage render > paged-middle > snapshot (was: full document render) 1`] = `
"<div class="uhead">
  <h1>Token usage</h1>
  <span class="sub" id="sub">Last 7 days</span>
  <div class="ranges" id="ranges"><button type="button" class="k-chip" data-range="24h" aria-pressed="false">Last 24 hours</button><button type="button" class="k-chip" data-range="7d" aria-pressed="true">Last 7 days</button><button type="button" class="k-chip" data-range="30d" aria-pressed="false">Last 30 days</button><button type="button" class="k-chip" data-range="all" aria-pressed="false">All time</button></div>
</div>

<div class="err hidden" id="err"></div>

<div id="body" class="">
  <div class="stats" id="stats"><div class="stat"><div class="k">Fresh tokens</div><div class="v">50k</div><div class="n">50000</div></div><div class="stat"><div class="k">Input</div><div class="v">0</div><div class="n"></div></div><div class="stat"><div class="k">Output</div><div class="v">0</div><div class="n"></div></div><div class="stat"><div class="k">Reasoning</div><div class="v">0</div><div class="n"></div></div><div class="stat"><div class="k">Cache read</div><div class="v">0</div><div class="n">billed apart from fresh</div></div><div class="stat"><div class="k">Calls</div><div class="v">100</div><div class="n"></div></div><div class="stat"><div class="k">Estimated</div><div class="v">0</div><div class="n">all measured</div></div></div>
  <div class="grid">
    <div class="panel stages">
      <div class="phead">By stage<span class="count" id="stageCount">3</span></div>
      <div class="pbody" id="stages"><div class="brow"><div class="line"><span class="lbl" title="Stage 0">Stage 0</span><span class="amt" title="1000 tokens">1k</span><span class="pct">20%</span></div><div class="bar"><i style="width:20%"></i></div><div class="meta">10 calls · in 0k · out 1k</div></div><div class="brow"><div class="line"><span class="lbl" title="Stage 1">Stage 1</span><span class="amt" title="2000 tokens">2k</span><span class="pct">40%</span></div><div class="bar"><i style="width:40%"></i></div><div class="meta">11 calls · in 1k · out 2k</div></div><div class="brow"><div class="line"><span class="lbl" title="Stage 2">Stage 2</span><span class="amt" title="3000 tokens">3k</span><span class="pct">60%</span></div><div class="bar"><i style="width:60%"></i></div><div class="meta">12 calls · in 2k · out 3k</div></div></div>
    </div>
    <div class="panel models">
      <div class="phead">By model<span class="count" id="modelCount">2</span></div>
      <div class="pbody" id="models"><div class="brow"><div class="line"><span class="lbl" title="Stage 0">Stage 0</span><span class="amt" title="1000 tokens">1k</span><span class="pct">20%</span></div><div class="bar"><i style="width:20%"></i></div><div class="meta">10 calls · in 0k · out 1k</div></div><div class="brow"><div class="line"><span class="lbl" title="Stage 1">Stage 1</span><span class="amt" title="2000 tokens">2k</span><span class="pct">40%</span></div><div class="bar"><i style="width:40%"></i></div><div class="meta">11 calls · in 1k · out 2k</div></div></div>
    </div>
    <div class="panel profiles">
      <div class="phead">Graph spend by profile<span class="count" id="profileCount">2</span></div>
      <div class="pbody" id="profiles"><div class="brow"><div class="line"><span class="lbl" title="Profile 0">Profile 0</span><span class="amt" title="800 tokens">0.8k</span><span class="pct">15%</span></div><div class="bar"><i style="width:15%"></i></div><div class="meta">8 calls · in 0k · out 0.3k</div></div><div class="brow"><div class="line"><span class="lbl" title="Profile 1">Profile 1</span><span class="amt" title="1600 tokens">1.6k</span><span class="pct">30%</span></div><div class="bar"><i style="width:30%"></i></div><div class="meta">9 calls · in 0.5k · out 0.6k</div></div></div>
    </div>
  </div>
  <div class="panel">
    <div class="phead">By ticket<span class="count" id="tktCount">60</span></div>
    <div class="tscroll">
      <table>
        <thead><tr id="thead"><th>Ticket</th><th class="num" aria-sort="descending"><button type="button" class="k-btn k-btn--link" data-sort="calls">Calls</button></th><th class="num"><button type="button" class="k-btn k-btn--link" data-sort="input">Input</button></th><th class="num"><button type="button" class="k-btn k-btn--link" data-sort="output">Output</button></th><th class="num"><button type="button" class="k-btn k-btn--link" data-sort="total">Total</button></th><th class="num"><button type="button" class="k-btn k-btn--link" data-sort="recent">Last call</button></th></tr></thead>
        <tbody id="tbody"><tr><td class="tkt"><button type="button" class="k-btn k-btn--link" data-ticket="900001" title="FEAT-100 — Ticket 1" aria-label="FEAT-100 — Ticket 1">FEAT-100 — Ticket 1</button></td><td class="num">5</td><td class="num">0k</td><td class="num">0.2k</td><td class="num" title="500 tokens">0.5k</td><td class="num">Jan 1</td></tr><tr><td class="tkt"><button type="button" class="k-btn k-btn--link" data-ticket="900002" title="FEAT-101 — Ticket 2" aria-label="FEAT-101 — Ticket 2">FEAT-101 — Ticket 2</button></td><td class="num">6</td><td class="num">0.3k</td><td class="num">0.4k</td><td class="num" title="1000 tokens">1k</td><td class="num">Jan 2</td></tr><tr><td class="tkt"><button type="button" class="k-btn k-btn--link" data-ticket="900003" title="FEAT-102 — Ticket 3" aria-label="FEAT-102 — Ticket 3">FEAT-102 — Ticket 3</button></td><td class="num">7</td><td class="num">0.6k</td><td class="num">0.6000000000000001k</td><td class="num" title="1500 tokens">1.5k</td><td class="num">Jan 3</td></tr></tbody>
      </table>
    </div>
    <div class="pager" id="pager"><span>21–23 of 60</span><span class="spacer"></span><button type="button" class="k-btn k-btn--secondary k-btn--sm" data-page="0" title="Show the previous page of tickets">Previous</button><button type="button" class="k-btn k-btn--secondary k-btn--sm" data-page="40" title="Show the next page of tickets">Next</button></div>
  </div>
</div>

<div class="k-empty hidden" id="empty">
  <div class="k-empty-title">No AI token usage recorded yet</div>
  <div class="k-empty-hint" id="emptyHint">Nothing was recorded for last 7 days. Try a wider range, or run an AI-backed action (ticket analysis, PR description).</div>
</div>

