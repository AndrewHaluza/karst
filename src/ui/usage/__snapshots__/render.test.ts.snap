  return '<svg class="' + k + '" width="' + size + '" height="' + size
    + '" viewBox="0 0 24 24" aria-hidden="true" focusable="false">'
    + paths + '</svg>';
}

  const vscode = acquireVsCodeApi();
  const post = (msg) => vscode.postMessage(msg);
  const el = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));

  // Columns of the per-ticket table. \`sort\` is the key posted back when the
  // header is clicked; a column without one is not sortable. The set matches
  // USAGE_SORTS host-side — an unknown key is rejected there, never applied.
  const COLUMNS = [
    { key: 'ticket', label: 'Ticket' },
    { key: 'calls', label: 'Calls', sort: 'calls', num: true },
    { key: 'input', label: 'Input', sort: 'input', num: true },
    { key: 'output', label: 'Output', sort: 'output', num: true },
    { key: 'total', label: 'Total', sort: 'total', num: true },
    { key: 'last', label: 'Last call', sort: 'recent', num: true },
  ];

  let lastState = null;
  // The last error string already surfaced through the toast, so a re-render
  // of an unchanged rejected query does not re-announce it (UI-R27).
  let lastErrorShown = null;

  /** An ISO stamp as the viewer's local date. The host sends the instant. */
  const localDate = (iso) => {
    if (!iso) return '';
    const d = new Date(iso);
    return isNaN(d.getTime()) ? '' : d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  };

