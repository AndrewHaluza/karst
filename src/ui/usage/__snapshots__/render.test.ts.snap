  <span class="sub" id="sub">Last 24 hours</span>
  <div class="ranges" id="ranges"><button type="button" class="k-chip" data-range="24h" aria-pressed="true">Last 24 hours</button><button type="button" class="k-chip" data-range="7d" aria-pressed="false">Last 7 days</button><button type="button" class="k-chip" data-range="30d" aria-pressed="false">Last 30 days</button><button type="button" class="k-chip" data-range="all" aria-pressed="false">All time</button></div>
</div>

<div class="err" id="err">fixture: Query rejected — range not valid for this project</div>

