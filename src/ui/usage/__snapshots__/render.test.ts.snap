015.635 2.31C6.315 1.464 7.132.846 8.086.457zm-.804 7.85a.848.848 0 00-1.473.842l1.694 2.965-1.688 2.848a.849.849 0 001.46.864l1.94-3.272a.849.849 0 00.007-.854l-1.94-3.393zm5.446 6.24a.849.849 0 000 1.695h4.848a.849.849 0 000-1.696h-4.848z"></path></svg></span><span class="agentname">Codex</span></span></span><span class="amt" title="300,000 tokens">300k</span><span class="pct">30%</span></div><div class="bar" aria-hidden="true"><i class="bar-nz" style="width:30%"></i></div><div class="meta">6 calls · in 120k · out 135k</div></div><div class="brow"><div class="line"><span class="lbl" title="OpenCode"><span class="agentbadge"><span class="agenticon" aria-hidden="true"><svg fill="currentColor" fill-rule="evenodd" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M16 6H8v12h8V6zm4 16H4V2h16v20z"></path></svg></span><span class="agentname">OpenCode</span></span></span><span class="amt" title="200,000 tokens">200k</span><span class="pct">20%</span></div><div class="bar" aria-hidden="true"><i class="bar-nz" style="width:20%"></i></div><div class="meta">6 calls · in 80k · out 90k</div></div></div>
