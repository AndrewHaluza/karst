exports[`dashboard region parity (DOM contract) > artView #artView · closed > artView · closed 1`] = `"<div#artView.artview.hidden tabindex="-1">"`;

exports[`dashboard region parity (DOM contract) > artView #artView · detail > artView · detail 1`] = `
"<div#artView.artview tabindex="-1">
  <div.drillhead data-region="drill-head">
    <button.dh-back.k-btn.k-btn--ghost.k-btn--sm aria-label="Back to Artifacts" data-art="back" title="Back to Artifacts" type="button">
      <span aria-hidden="true"> "←"
      <span.dh-backlabel> "Artifacts"
    <nav.dh-trail aria-label="Breadcrumb">
      <ol>
        <li.dh-mid>
          <button.dh-link type="button"> "Artifacts"
        <li.dh-current>
          <span aria-current="page" title="UAT report"> "UAT report"
    <kbd.dh-esc aria-hidden="true"> "Esc"
  <div.artdetail>
    <div.arthero>
      <span.art-title> "UAT report"
      <span.art-status.passed> "Passed"
    <div.artcard-summary> "2 passed · 1 failed"
    <div.artdetail-grid>
      <div.artmain>
        <div.artmetrics>
          <span.artmetric> "2"
            <span.am-label> "done"
        <section.artsection aria-label="Gate runs">
          <div.artheading> "Gate runs"
            <span.sp>
              <button.ib.k-iconbtn.t-open aria-label="View this stage's console output in the dashboard" data-act="console" data-console="uat" title="View this stage's console output in the dashboard" type="button">
                <svg.k-icon aria-hidden="true">
          <div.artgate>
            <span.ag-state.pass>
              <span.ag-dot aria-label="passed" role="img">
            <span.ag-name> "lint"
            <span.ag-code> "exit 0"
          <div.artgate>
            <span.ag-state.fail>
              <span.ag-dot aria-label="failed" role="img">
            <span.ag-name> "e2e"
            <span.ag-code> "exit 2"
      <aside.artside aria-label="About this artifact">
        <section.artsection aria-label="Details">
          <div.artheading> "Details"
          <div.artmeta>
            <span.am-key> "Stage"
            <span> "UAT"
            <span.am-key> "Produced by"
            <span.am-origin>
              <span.art-origin aria-label="karst artifact for Codex">
                <svg.kmark aria-hidden="true">
                <span> "Karst · Codex"
              <button.ib.k-iconbtn.t-open aria-label="View the Tester's console output in the dashboard" data-act="console" data-console="uat" data-console-proc="tester" title="View the Tester's console output in the dashboard" type="button">
                <svg.k-icon aria-hidden="true">
            <span.am-key> "Version"
            <span> "v1 · current"
            <span.am-key> "Created"
            <span> "<stamp>"
        <section.artsection aria-label="Underlying files">
          <div.artheading> "Underlying files"
          <ul.artfiles>
            <li>
              <span.af-label> "UAT log"
              <span.af-name> "uat.log"
              <button.k-btn.k-btn--secondary.k-btn--sm data-act="artifact-open-resource" data-artifact-id="uat-report" data-index="0" title="Open UAT log (uat.log) in the editor" type="button"> "Open in editor ↗""
`;

exports[`dashboard region parity (DOM contract) > artView #artView · index > artView · index 1`] = `
