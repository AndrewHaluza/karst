        <li.dh-current>
          <span aria-current="page" title="Artifacts · 5"> "Artifacts · 5"
    <div.dh-actions>
      <span.sa-bar>
        <button.k-btn.k-btn--ghost.k-btn--sm data-act="stored-artifact-reveal" title="Check out the latest files read-only and show the folder" type="button"> "Reveal folder"
        <button.k-btn.k-btn--ghost.k-btn--sm data-act="stored-artifact-purge" title="Delete every stored revision for this ticket" type="button"> "Purge files…"
    <kbd.dh-esc aria-hidden="true"> "Esc"
  <section.artgroup aria-label="Implement artifacts">
    <div.artgroup-title> "Implement"
    <ul.artrows>
      <li>
        <button.artrow data-art-open="plan" type="button">
          <span.artrow-body>
            <span.artrow-title> "Plan"
            <span.artrow-summary> "3 tasks · 2 done"
          <span.art-status.info> "In progress"
          <span.art-origin aria-label="karst artifact for Codex">
            <svg.kmark aria-hidden="true">
            <span> "Karst · Codex"
          <span.arw aria-hidden="true"> "›"
  <section.artgroup aria-label="UAT artifacts">
    <div.artgroup-title> "UAT"
    <ul.artrows>
      <li>
        <button.artrow data-art-open="uat-report" type="button">
          <span.artrow-body>
            <span.artrow-title> "UAT report"
            <span.artrow-summary> "2 passed · 1 failed"
          <span.art-status.passed> "Passed"
          <span.art-origin aria-label="karst artifact for Codex">
            <svg.kmark aria-hidden="true">
            <span> "Karst · Codex"
          <span.arw aria-hidden="true"> "›"
  <section.artgroup aria-label="Review artifacts">
    <div.artgroup-title> "Review"
    <ul.artrows>
      <li>
        <button.artrow data-art-open="review" type="button">
          <span.artrow-body>
            <span.artrow-title> "Review"
            <span.artrow-summary> "1 finding"
          <span.art-status.attention> "Needs attention"
          <span.art-stale title="No longer validates the current implementation"> "Stale"
          <span.art-origin aria-label="karst artifact for Codex">
            <svg.kmark aria-hidden="true">
            <span> "Karst · Codex"
          <span.arw aria-hidden="true"> "›""
`;

