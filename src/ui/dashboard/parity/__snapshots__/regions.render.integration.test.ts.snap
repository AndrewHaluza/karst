exports[`dashboard region parity (DOM contract) > envView #envView · closed > envView · closed 1`] = `"<div#envView.envview.hidden tabindex="-1">"`;

exports[`dashboard region parity (DOM contract) > envView #envView · editor open > envView · editor open 1`] = `
"<div#envView.envview tabindex="-1">
  <div.drillhead data-region="drill-head">
    <button.dh-back.k-btn.k-btn--ghost.k-btn--sm aria-label="Back to Dashboard" data-art="back" title="Back to Dashboard" type="button">
      <span aria-hidden="true"> "←"
      <span.dh-backlabel> "Dashboard"
    <nav.dh-trail aria-label="Breadcrumb">
      <ol>
        <li.dh-current>
          <span aria-current="page" title="Env variables"> "Env variables"
    <kbd.dh-esc aria-hidden="true"> "Esc"
  <div.ebody>
    <div.elead> "One per line. These extend each service’s own and override the keys they name — for this ticket only. The repository’s file is never written. Saved values apply the next time the services are started."
      <code> "KEY=value"
      <code> ".env"
      <code> ".env"
    <section.envscope>
      <header>
        <span.ename> "All services"
        <span.ecount> "1 variable"
      <div.ehint> "Applied to every service of this ticket. A service’s own section below wins where both name the same variable."
      <label.sr for="env-ta-*"> "Environment variables for All services"
      <textarea#env-ta-*.k-input data-env-scope="*" placeholder="APP_HISTORY_FEATURE=true"> "A=1"
      <footer>
        <button.k-btn.k-btn--primary.k-btn--sm data-env-save="*" title="Save these variables for this ticket" type="button"> "Save"
        <button.k-btn.k-btn--ghost.k-btn--sm data-env-revert="*" title="Discard unsaved edits to this section" type="button"> "Revert"
        <span.msg role="status">
    <section.envscope>
      <header>
        <span.ename> "web"
        <span.ecount> "1 variable"
      <div.ehint> "Applied to web only."
      <label.sr for="env-ta-web"> "Environment variables for web"
      <textarea#env-ta-web.k-input data-env-scope="web" placeholder="APP_HISTORY_FEATURE=true"> "PORT=5173"
      <footer>
        <button.k-btn.k-btn--primary.k-btn--sm data-env-save="web" title="Save these variables for this ticket" type="button"> "Save"
        <button.k-btn.k-btn--ghost.k-btn--sm data-env-revert="web" title="Discard unsaved edits to this section" type="button"> "Revert"
        <span.msg role="status">
    <section.envscope>
      <header>
        <span.ename> "api"
        <span.ecount> "none set"
      <div.ehint> "Applied to api only."
      <label.sr for="env-ta-api"> "Environment variables for api"
      <textarea#env-ta-api.k-input data-env-scope="api" placeholder="APP_HISTORY_FEATURE=true">
      <footer>
        <button.k-btn.k-btn--primary.k-btn--sm data-env-save="api" title="Save these variables for this ticket" type="button"> "Save"
        <button.k-btn.k-btn--ghost.k-btn--sm data-env-revert="api" title="Discard unsaved edits to this section" type="button"> "Revert"
        <span.msg role="status">"
`;

exports[`dashboard region parity (DOM contract) > header .dhead · closed ticket that can reopen > header · closed ticket that can reopen 1`] = `
"<div.dhead data-region="ticket-head">
  <div.ticketIdentity aria-label="T942017 · FEAT-142 · Add per-repo base branch override to the worktree picker" role="group" title="T942017 · FEAT-142 · Add per-repo base branch override to the worktree picker">
    <span#providerMark.provicon aria-hidden="true">
    <span#idBadge.k-id> "T942017"
    <span#statusChip.info.k-chip.ticketStatus> "Closed"
    <button#keyBtn.ticketKey aria-label="Copy ticket key FEAT-142" data-act="copy-ticket-key" data-copy title="Copy ticket key" type="button"> "FEAT-142"
    <span#priorityChip.prio aria-label hidden>
    <a#boardLink.k-iconbtn aria-label="Open ticket in provider" data-act="open-ticket-link" hidden href="#" title="Open ticket in provider">
      <svg.k-icon aria-hidden="true">
    <button#ticketDataBtn.k-iconbtn aria-label="Preview ticket data" data-act="preview-ticket-data" title="Preview ticket data" type="button">
      <svg.k-icon aria-hidden="true">
  <h1#title.ticketTitle title="T942017 · FEAT-142 · Add per-repo base branch override to the worktree picker"> "Add per-repo base branch override to the worktree picker"
  <div.headerActions>
    <span#toast.toast aria-live="polite">
    <span#shipWait.hidden.shipWait role="status">
      <span.attentionMark aria-hidden="true"> "❚❚"
      <span> "Waiting to merge"
    <span#subtaskWait.hidden.shipWait role="status">
      <span.attentionMark aria-hidden="true"> "❚❚"
      <span#subtaskWaitText> "Waiting on sub-tasks"
    <span#pauseWait.hidden.shipWait role="status">
      <span.attentionMark aria-hidden="true"> "❚❚"
      <span> "Execution paused"
      <button.k-btn.k-btn--secondary.k-btn--sm data-act="unpause-execution" type="button"> "Resume"
    <div.agentWrap>
      <button#agentButton.agentButton aria-expanded="false" aria-haspopup="dialog" title="Switch the agent core and model" type="button">
        <span#agentCore.k-agent-core>
          <span.agentbadge>
            <span.agenticon aria-hidden="true">
              <svg>
            <span.agentname> "Claude Code"
        <span.agentSep aria-hidden="true"> "·"
        <span#agentModel.agentMeta> "Agent default"
        <span.agentLive>
          <span#agentDot.agentLiveDot.none>
          <span#agentLiveText> "none"
        <svg.k-icon aria-hidden="true">
      <div#agentPopover.agentPopover.hidden.popover aria-label="Switch active agent" role="dialog">
        <div.agentForm>
          <div#agentSwitchPicker>
          <div.fieldHelp> "Agent core, model and effort changes are staged. Closing this menu takes no action."
        <div.popActions>
          <button#switchBtn.k-btn.k-btn--primary disabled type="button"> "Switch agent…"
    <div.menuWrap>
      <button#moreBtn.k-iconbtn aria-expanded="false" aria-haspopup="menu" aria-label="Ticket controls" title="Ticket controls" type="button">
        <svg.k-icon aria-hidden="true">
      <div#menuPopover.hidden.menuPopover.popover aria-label="Ticket controls" role="menu">
        <div.menuHeading> "Ticket"
        <button.menuButton data-act="edit-ticket" role="menuitem" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Edit ticket"
        <button#pauseItem.menuButton data-act="pause-execution" role="menuitem" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Pause execution"
        <button#resumeItem.hidden.menuButton data-act="unpause-execution" role="menuitem" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Resume execution"
        <button#followUpItem.hidden.menuButton data-act="create-follow-up-ticket" role="menuitem" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Create follow-up"
        <button#detachSubtask.hidden.menuButton data-act="detach-subtask" role="menuitem" title="Detach this sub-task from its parent and rebase it onto the root base" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Detach from parent…"
        <button#closeTicket.danger.hidden.menuButton data-act="close-ticket" role="menuitem" title="Mark closed: the work was done outside Karst. Nothing is verified" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Close — done outside Karst…"
        <button#reopenTicket.menuButton data-act="reopen-ticket" role="menuitem" title="Bring this closed ticket back to implementation" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Reopen"
        <div.menuDivider>
        <div.menuHeading> "Quick setting"
        <div.settingRow>
          <div.settingCopy>
            <div.settingTitle> "Link dashboard ↔ terminal"
            <div.settingHelp> "Global · focusing either view brings the paired view forward."
          <label#linkViewsLabel.k-switch aria-checked="false" aria-label="Link dashboard and terminal" role="switch">
            <input#linkViews tabindex="-1" type="checkbox">
            <span.k-switch-track>
        <div.menuDivider>
        <div.menuHeading> "Gates for this ticket"
        <div#menuGates.menuGates>"
`;

