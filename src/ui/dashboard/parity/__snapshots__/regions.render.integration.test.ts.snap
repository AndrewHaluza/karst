                  <svg.k-icon aria-hidden="true">
                <button.ib.k-iconbtn.t-copy aria-label="Copy URL" data-act="copy-server-url" data-copy data-id="2" title="Copy URL" type="button">
                  <svg.k-icon aria-hidden="true">
