exports[`dashboard region parity (DOM contract) > root #root · sandbox strip with carry > root · sandbox strip with carry 1`] = `
"<div#root>
  <div data-karst-dashboard-app="true" data-react-owned="true" data-testid="dashboard-app-root">
    <div.sandbox-strip aria-label="Sandbox" data-region="sandbox" data-testid="sandbox-strip" role="region">
      <div.sandbox-strip-main>
        <span.sandbox-strip-title>
          <svg.k-icon aria-hidden="true">
          <span> "Sandbox"
        <span.sandbox-backend-tag data-testid="sandbox-backend-tag"> "sbx"
        <span.sandbox-sep aria-hidden="true"> "·"
        <span.agentbadge data-testid="sandbox-core-identity" title="Agent core: Claude Code">
          <span.agenticon-island>
            <span.agenticon aria-hidden="true">
              <svg>
          <span.agentname> "Claude Code"
        <span.sandbox-sep aria-hidden="true"> "·"
        <span.sandbox-badge aria-haspopup="true" aria-label="Filesystem Containment: Isolated Git Clone" data-testid="sandbox-workspace-badge" role="button" tabindex="0" title="workspace: clone">
          <svg.k-icon aria-hidden="true">
          <span> "Isolated Git Clone"
          <svg.k-icon.k-icon-chevron aria-hidden="true">
          <div.sandbox-popover role="tooltip">
            <div.sandbox-popover-header>
              <svg.k-icon.k-icon-success aria-hidden="true">
              <span> "Filesystem Containment"
            <div.sandbox-popover-title> "Isolation Boundary"
            <div.sandbox-popover-body> "Runs in a private, standalone Git clone inside the container. Never mounts your host worktree or shared ."
              <code> ".git"
            <div.sandbox-popover-title> "Host Synchronization"
            <div.sandbox-popover-body> "Agent edits and commits remain contained in the container until you click or the stage successfully finishes."
              <strong> "Sync"
            <div.sandbox-popover-footer>
              <svg.k-icon.k-icon-success aria-hidden="true">
              <span> "Host workspace and git hooks are fully protected."
        <span.sandbox-sep aria-hidden="true"> "·"
        <span.sandbox-badge aria-haspopup="true" aria-label="Network Allowlist Perimeter: Allowlist Proxy" data-testid="sandbox-network-badge" role="button" tabindex="0" title="network: sbx network policy (allowlist)">
          <svg.k-icon aria-hidden="true">
          <span> "Allowlist Proxy"
          <svg.k-icon.k-icon-chevron aria-hidden="true">
          <div.sandbox-popover role="tooltip">
            <div.sandbox-popover-header>
              <svg.k-icon.k-icon-success aria-hidden="true">
              <span> "Network Allowlist Perimeter"
            <div.sandbox-popover-title> "AI Model Endpoints"
            <ul.sandbox-popover-domain-list>
              <li.sandbox-popover-domain-tag> "api.anthropic.com"
              <li.sandbox-popover-domain-tag> "api.openai.com"
              <li.sandbox-popover-domain-tag> "opencode.ai"
              <li.sandbox-popover-domain-tag> "openrouter.ai"
            <div.sandbox-popover-title> "Package Registries"
            <ul.sandbox-popover-domain-list>
              <li.sandbox-popover-domain-tag> "registry.npmjs.org"
              <li.sandbox-popover-domain-tag> "pypi.org"
              <li.sandbox-popover-domain-tag> "crates.io"
              <li.sandbox-popover-domain-tag> "proxy.golang.org"
              <li.sandbox-popover-domain-tag> "rubygems.org"
            <div.sandbox-popover-footer>
              <svg.k-icon.k-icon-warning aria-hidden="true">
              <span> "All other outbound and LAN traffic is blocked."
      <div.sandbox-strip-actions>
        <button.k-btn.k-btn--secondary.k-btn--sm aria-label="Sync sandbox commits into the worktree" data-act="sandbox-sync" title="Sync sandbox commits into the worktree" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Sync"
        <button.k-btn.k-btn--secondary.k-btn--sm aria-label="Show what a sync would bring in" data-act="sandbox-diff" title="Show what a sync would bring in" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Diff"
        <button.k-btn.k-btn--secondary.k-btn--sm aria-label="Stash uncommitted sandbox changes and update from the host" data-act="sandbox-stash-update" title="Stash uncommitted sandbox changes (kept in git stash) and update from the host" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Stash & update"
        <button.k-btn.k-btn--secondary.k-btn--sm aria-label="Stop the sandbox (kept for the next open)" data-act="sandbox-stop" title="Stop the sandbox (kept for the next open)" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Stop"
        <button.k-btn.k-btn--secondary.k-btn--sm aria-label="Carry sandbox commits onto host branch" data-act="sandbox-carry" title="Carry sandbox commits onto host branch" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Carry to host"
        <button.k-btn.k-btn--danger.k-btn--sm aria-label="Remove the sandbox" data-act="sandbox-remove" title="Remove the sandbox" type="button">
          <svg.k-icon aria-hidden="true">
          <span> "Remove…""
`;

